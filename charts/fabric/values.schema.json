{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://singleaxis.com/schemas/fabric-chart-values-v1.json",
  "title": "SingleAxis Fabric umbrella chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tenant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name"],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Tenant identifier. Production profiles enforce that this is non-empty."
        },
        "name": {"type": "string", "maxLength": 253}
      }
    },
    "global": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fabric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
          }
        }
      }
    },
    "namespace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations", "labels"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "labels": {"$ref": "#/definitions/stringMap"}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["denyDefault"],
      "properties": {"denyDefault": {"type": "boolean"}}
    },
    "otelCollector": {"$ref": "#/definitions/toggle"},
    "otel-collector": {"type": "object", "description": "Validated by the bundled otel-collector subchart schema."},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"enum": ["shadow-dev", "shadow-production"]}
      }
    },
    "tags": {
      "type": "object",
      "description": "Standard Helm dependency tags; extension keys are intentional.",
      "additionalProperties": {"type": "boolean"}
    }
  },
  "required": [
    "tenant",
    "global",
    "namespace",
    "networkPolicy",
    "otelCollector",
    "profile"
  ],
  "definitions": {
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    }
  }
}
