{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://singleaxis.com/schemas/fabric-otel-collector-chart-values-v1.json",
  "title": "SingleAxis Fabric OpenTelemetry Collector chart values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "global": {
      "type": "object",
      "description": "Helm globals are shared by every dependency and are intentionally extensible.",
      "properties": {
        "fabric": {
          "type": "object",
          "properties": {"version": {"type": "string"}}
        }
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 100},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string"},
        "digest": {"type": "string", "pattern": "^(?:|sha256:[0-9a-f]{64})$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "imagePullSecrets": {"$ref": "#/definitions/imagePullSecrets"},
    "nameOverride": {"type": "string", "maxLength": 63},
    "fullnameOverride": {"type": "string", "maxLength": 63},
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "annotations", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "name": {"type": "string", "maxLength": 253}
      }
    },
    "podAnnotations": {"$ref": "#/definitions/stringMap"},
    "podLabels": {"$ref": "#/definitions/stringMap"},
    "enableServiceLinks": {"type": "boolean"},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
    "podSecurityContext": {"$ref": "#/definitions/kubernetesObject"},
    "securityContext": {"$ref": "#/definitions/kubernetesObject"},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "ports"],
      "properties": {
        "type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "required": ["otlpGrpc", "otlpHttp", "health"],
          "properties": {
            "otlpGrpc": {"$ref": "#/definitions/port"},
            "otlpHttp": {"$ref": "#/definitions/port"},
            "health": {"$ref": "#/definitions/port"}
          }
        }
      }
    },
    "receiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireTLS", "requireClientCertificate", "tls"],
      "properties": {
        "requireTLS": {"type": "boolean"},
        "requireClientCertificate": {"type": "boolean"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["serverCertificateSecret", "clientCASecret"],
          "properties": {
            "serverCertificateSecret": {"$ref": "#/definitions/certificateSecretReference"},
            "clientCASecret": {"$ref": "#/definitions/secretKeyReference"}
          }
        }
      }
    },
    "resources": {"$ref": "#/definitions/kubernetesObject"},
    "livenessProbe": {"$ref": "#/definitions/probe"},
    "readinessProbe": {"$ref": "#/definitions/probe"},
    "startupProbe": {"$ref": "#/definitions/probe"},
    "nodeSelector": {"$ref": "#/definitions/stringMap"},
    "tolerations": {"type": "array", "items": {"$ref": "#/definitions/kubernetesObject"}},
    "affinity": {"$ref": "#/definitions/kubernetesObject"},
    "topologySpreadConstraints": {"type": "array", "items": {"$ref": "#/definitions/kubernetesObject"}},
    "fabric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guard"],
      "properties": {
        "guard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventClassAttribute", "dropUnknownClasses", "maxFieldBytes", "extraAllowedFields", "extraAllowedTraceFields"],
          "properties": {
            "eventClassAttribute": {"type": "string", "minLength": 1, "maxLength": 255},
            "dropUnknownClasses": {"type": "boolean"},
            "maxFieldBytes": {"type": "integer", "minimum": 1, "maximum": 16777216},
            "extraAllowedFields": {
              "type": "object",
              "propertyNames": {"minLength": 1},
              "additionalProperties": {
                "type": "array",
                "items": {"type": "string", "minLength": 1},
                "uniqueItems": true
              }
            },
            "extraAllowedTraceFields": {
              "type": "array",
              "items": {"type": "string", "minLength": 1},
              "uniqueItems": true
            }
          }
        }
      }
    },
    "exporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "insecure", "insecureSkipVerify", "requireTLS", "tls", "auth", "requireAuth", "requireEndpoint", "sendingQueue", "retry", "timeout", "requireDurableQueue"],
      "properties": {
        "endpoint": {"type": "string", "pattern": "^$|^https?://"},
        "insecure": {"type": "boolean"},
        "insecureSkipVerify": {"type": "boolean"},
        "requireTLS": {"type": "boolean"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caSecret", "clientCertificateSecret"],
          "properties": {
            "caSecret": {"$ref": "#/definitions/secretKeyReference"},
            "clientCertificateSecret": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "certKey", "keyKey"],
              "properties": {
                "name": {"type": "string", "maxLength": 253},
                "certKey": {"type": "string", "minLength": 1},
                "keyKey": {"type": "string", "minLength": 1}
              }
            }
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["headerName", "secret"],
          "properties": {
            "headerName": {"type": "string", "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"},
            "secret": {"$ref": "#/definitions/secretKeyReference"}
          }
        },
        "requireAuth": {"type": "boolean"},
        "requireEndpoint": {"type": "boolean"},
        "sendingQueue": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "numConsumers", "queueSize", "blockOnOverflow", "persistence"],
          "properties": {
            "enabled": {"type": "boolean"},
            "numConsumers": {"type": "integer", "minimum": 1, "maximum": 1000},
            "queueSize": {"type": "integer", "minimum": 1, "maximum": 10000000},
            "blockOnOverflow": {"type": "boolean"},
            "persistence": {
              "type": "object",
              "additionalProperties": false,
              "required": ["enabled", "directory", "fsync", "existingClaim", "accessModes", "size", "storageClass", "annotations"],
              "properties": {
                "enabled": {"type": "boolean"},
                "directory": {"type": "string", "pattern": "^/", "minLength": 2},
                "fsync": {"type": "boolean"},
                "existingClaim": {"type": "string", "maxLength": 253},
                "accessModes": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}
                },
                "size": {"type": "string", "minLength": 1},
                "storageClass": {"type": "string"},
                "annotations": {"$ref": "#/definitions/stringMap"}
              }
            }
          }
        },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "initialInterval", "maxInterval", "maxElapsedTime"],
          "properties": {
            "enabled": {"type": "boolean"},
            "initialInterval": {"$ref": "#/definitions/duration"},
            "maxInterval": {"$ref": "#/definitions/duration"},
            "maxElapsedTime": {"$ref": "#/definitions/duration"}
          }
        },
        "timeout": {"$ref": "#/definitions/duration"},
        "requireDurableQueue": {"type": "boolean"}
      }
    },
    "debugExporter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "verbosity"],
      "properties": {
        "enabled": {"type": "boolean"},
        "verbosity": {"enum": ["basic", "normal", "detailed"]}
      }
    },
    "memoryLimiter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkIntervalSeconds", "limitMib"],
      "properties": {
        "checkIntervalSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "limitMib": {"type": "integer", "minimum": 1}
      }
    },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "timeoutSeconds", "sendBatchSize"],
      "properties": {
        "enabled": {"type": "boolean"},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 3600},
        "sendBatchSize": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minAvailable"],
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {
          "oneOf": [
            {"type": "integer", "minimum": 0},
            {"type": "string", "pattern": "^(100|[0-9]{1,2})%$"}
          ]
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "requireExplicitIngress", "ingressFrom", "exporterEgress", "egressTo", "monitoringNamespaceSelector"],
      "properties": {
        "enabled": {"type": "boolean"},
        "requireExplicitIngress": {"type": "boolean"},
        "ingressFrom": {"type": "array", "items": {"$ref": "#/definitions/kubernetesObject"}},
        "exporterEgress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requireExplicit", "to", "ports"],
          "properties": {
            "requireExplicit": {"type": "boolean"},
            "to": {"type": "array", "items": {"$ref": "#/definitions/kubernetesObject"}},
            "ports": {"type": "array", "items": {"$ref": "#/definitions/networkPolicyPort"}}
          }
        },
        "egressTo": {"type": "array", "items": {"$ref": "#/definitions/kubernetesObject"}},
        "monitoringNamespaceSelector": {
          "$ref": "#/definitions/kubernetesObject",
          "description": "Optional LabelSelector for the monitoring namespace allowed to reach the health port. Empty means no health ingress rule (default deny)."
        }
      }
    }
  },
  "required": [
    "replicaCount", "image", "imagePullSecrets", "nameOverride", "fullnameOverride",
    "serviceAccount", "podAnnotations", "podLabels", "enableServiceLinks", "terminationGracePeriodSeconds", "podSecurityContext", "securityContext",
    "service", "receiver", "resources", "livenessProbe", "readinessProbe", "startupProbe", "nodeSelector",
    "tolerations", "affinity", "topologySpreadConstraints", "fabric", "exporter", "debugExporter",
    "memoryLimiter", "batch", "podDisruptionBudget", "networkPolicy"
  ],
  "definitions": {
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "duration": {"type": "string", "pattern": "^(?:0|(?:[0-9]+(?:ns|us|ms|s|m|h))+)$"},
    "stringMap": {"type": "object", "additionalProperties": {"type": "string"}},
    "kubernetesObject": {
      "type": "object",
      "description": "Kubernetes-native object; extensible so new Kubernetes fields do not require a chart release."
    },
    "probe": {
      "type": "object",
      "properties": {
        "initialDelaySeconds": {"type": "integer", "minimum": 0},
        "periodSeconds": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "successThreshold": {"type": "integer", "minimum": 1}
      }
    },
    "timingProbe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["periodSeconds", "failureThreshold", "timeoutSeconds"],
      "properties": {
        "periodSeconds": {"type": "integer", "minimum": 1},
        "failureThreshold": {"type": "integer", "minimum": 1},
        "timeoutSeconds": {"type": "integer", "minimum": 1}
      }
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {"name": {"type": "string", "minLength": 1}}
      }
    },
    "secretKeyReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string", "maxLength": 253},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "certificateSecretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "certKey", "keyKey"],
      "properties": {
        "name": {"type": "string", "maxLength": 253},
        "certKey": {"type": "string", "minLength": 1},
        "keyKey": {"type": "string", "minLength": 1}
      }
    },
    "networkPolicyPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "port"],
      "properties": {
        "protocol": {"enum": ["TCP", "UDP", "SCTP"]},
        "port": {
          "oneOf": [
            {"$ref": "#/definitions/port"},
            {"type": "string", "minLength": 1, "maxLength": 15}
          ]
        },
        "endPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    }
  }
}
