{
  "transformations": [
    {
      "id": "example-mask",
      "version": "1",
      "rules": [
        {"pattern": "[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}", "replacement": "[email]"},
        {"pattern": "\\b\\d{3}-\\d{2}-\\d{4}\\b", "replacement": "[ssn]"},
        {"pattern": "\\b(?:\\d[ -]?){12,18}\\d\\b", "replacement": "[card]"},
        {"pattern": "(?<!\\w)\\+?\\d{1,3}?[ .-]?\\(?\\d{3}\\)?[ .-]\\d{3}[ .-]\\d{4}\\b", "replacement": "[phone]"}
      ]
    }
  ]
}
