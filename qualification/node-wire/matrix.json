{
  "schema": "fabric.node-wire-matrix/v1",
  "comment": "Spec 055 §9.3: the client matrix of the TypeScript wire capture. Rows are transports and model clients, never agent frameworks: a row says how bytes reach undici or core HTTP. Each TS-1U/TS-1D row names its client script (clients/), the provider dialect its endpoint is configured with, the profiles it runs in (local and production in pseudonymous identity mode; one clear identity case per R8), what the record must show (its reader verdict: a row whose script aborts or cancels a call is `partial`, as Python's reader reports those calls, because a response cut short is a `truncated` gap; the test requires every verdict-lowering gap to be such a cut or a named loss), and the test that runs it. `deferred` rows belong to a later unit and are not claimed.",
  "rows": [
    {
      "id": "fetch-esm", "gate": "TS-1U", "transport": "global fetch (ES module application)",
      "script": "fetch-matrix.mjs", "dialect": "openai", "profiles": ["local", "production"],
      "test": "scripts/tests/test_node_wire_matrix.py",
      "scenarios": ["json_in_memory", "json_streamed_request_body", "sse", "gzip_json", "gzip_sse", "error_400", "error_after_headers", "abort_before_headers", "abort_mid_body", "abort_after_completion", "paused_consumer", "keep_alive_reuse", "non_matching"],
      "observes": {"abort_before_headers": "error", "abort_mid_body": "error", "error_after_headers": "error"},
      "expect": {"verdict": "partial"}
    },
    {
      "id": "fetch-cjs", "gate": "TS-1U", "transport": "global fetch (CommonJS application)",
      "script": "fetch-matrix.cjs", "dialect": "openai", "profiles": ["local", "production", "clear"],
      "test": "scripts/tests/test_node_wire_matrix.py",
      "scenarios": ["json_in_memory", "json_streamed_request_body", "sse", "gzip_json", "gzip_sse", "error_400", "error_after_headers", "abort_before_headers", "abort_mid_body", "abort_after_completion", "paused_consumer", "keep_alive_reuse", "non_matching"],
      "observes": {"abort_before_headers": "error", "abort_mid_body": "error"},
      "expect": {"verdict": "partial"}
    },
    {
      "id": "undici-external", "gate": "TS-1U", "transport": "external undici package 7.16.0: fetch, request, Client (pipelining), Pool; an HTTP/2-capable dispatcher (negative)",
      "script": "undici-external.mjs", "dialect": "openai", "profiles": ["local", "production"],
      "test": "scripts/tests/test_node_wire_matrix.py",
      "scenarios": ["global_fetch", "undici_fetch", "undici_request", "client_pipelining", "pool", "http2_dispatcher"],
      "qualified_versions": [],
      "expect": {"verdict": "partial", "min_complete": 0, "uninstrumented_client": 7, "lost_paths": ["/ok/", "/ext/"], "not_complete": true, "status_ids": ["FW-035"]},
      "note": "No external undici version is qualified in this release: every call it publishes is an uninstrumented_client loss and the process is not complete. Importing the undici package installs its own Agent as the process-wide dispatcher (undici's lib/global.js), so global fetch then sends through that copy too: the global fetch call of this script is the seventh loss. A process that never loads the undici package is unaffected (every other row)."
    },
