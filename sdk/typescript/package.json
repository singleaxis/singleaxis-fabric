{
  "name": "@singleaxis/fabric",
  "version": "0.8.0-rc.1",
  "description": "Customer-controlled OpenTelemetry capture SDK for reconstructing AI agent activity.",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singleaxis/singleaxis-fabric.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/singleaxis/singleaxis-fabric/tree/main/sdk/typescript",
  "bugs": {
    "url": "https://github.com/singleaxis/singleaxis-fabric/issues"
  },
  "keywords": [
    "opentelemetry",
    "observability",
    "ai-agents",
    "gen_ai",
    "tracing",
    "activity-correlation"
  ],
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:package": "node --test test/package-artifact.node.mjs",
    "package:qualified": "node scripts/package-qualified.mjs"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.0.0",
    "@opentelemetry/api": ">=1.9.0 <1.10.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/context-async-hooks": "2.10.0",
    "@opentelemetry/sdk-trace-node": "2.10.0",
    "@types/node": "22.18.0",
    "@typescript-eslint/eslint-plugin": "8.20.0",
    "@typescript-eslint/parser": "8.20.0",
    "eslint": "9.39.4",
    "prettier": "3.4.2",
    "tsup": "8.5.1",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "esbuild": "0.28.1"
  }
}
