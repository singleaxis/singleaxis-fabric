{
  "name": "@singleaxis/fabric",
  "version": "0.12.1",
  "description": "Customer-controlled OpenTelemetry capture SDK for reconstructing AI agent activity.",
  "license": "Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/singleaxis/singleaxis-fabric.git",
    "directory": "sdk/typescript"
  },
  "homepage": "https://github.com/singleaxis/singleaxis-fabric/tree/main/sdk/typescript",
  "bugs": {
    "url": "https://github.com/singleaxis/singleaxis-fabric/issues"
  },
  "keywords": [
    "opentelemetry",
    "observability",
    "ai-agents",
    "gen_ai",
    "tracing",
    "activity-correlation"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test": "vitest run",
    "test:package": "node --test test/package-artifact.node.mjs",
    "package:qualified": "node scripts/package-qualified.mjs"
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": ">=3.0.0",
    "@opentelemetry/api": ">=1.9.0 <1.10.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/sdk-trace-node": "2.12.0",
    "@types/node": "22.20.5",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "tsup": "9.0.0",
    "typescript": "5.7.3",
    "vitest": "5.0.5"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "minimatch": "11.0.5"
  }
}
