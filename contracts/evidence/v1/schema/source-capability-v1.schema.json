{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/contracts/evidence/v1/source-capability-v1.schema.json",
  "title": "AEEP source capability v1 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "connector_id", "version", "artifact_sha256",
    "boundaries", "operation_classes", "roles", "observation_level",
    "provenance", "tenant_binding", "trace_context", "sequence",
    "loss_detection", "spool_guarantee", "sampling", "surfaces", "bypasses", "known_blind_spots",
    "conformance_fixture_ids"
  ],
  "properties": {
    "schema_version": {"const": "agent.evidence.source-capability/v1"},
    "connector_id": {"$ref": "#/$defs/id"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "artifact_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["caller", "provider_bound", "tool", "terminal", "sandbox", "remote", "host", "service"]}},
    "operation_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["model", "tool", "terminal", "file", "sandbox", "remote", "database", "network", "retrieval", "memory", "messaging", "control_plane"]}},
    "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 80}},
    "observation_level": {"enum": ["content", "semantic_metadata", "host_provenance"]},
    "provenance": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["native", "protocol", "caller_reported", "inferred"]}},
    "tenant_binding": {"enum": ["authenticated", "asserted", "inferred", "none"]},
    "trace_context": {"enum": ["native", "propagated", "absent"]},
    "sequence": {"type": "boolean"},
    "loss_detection": {"enum": ["counter_and_heartbeat", "counter_only", "none"]},
    "spool_guarantee": {"enum": ["fsync_before_ack", "process_memory", "none"]},
    "sampling": {"enum": ["off", "configurable", "always"]},
    "surfaces": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["boundary", "operation_class", "roles", "observation_level", "bypass_test_ids"],
        "properties": {
          "boundary": {"enum": ["caller", "provider_bound", "tool", "terminal", "sandbox", "remote", "host", "service"]},
          "operation_class": {"enum": ["model", "tool", "terminal", "file", "sandbox", "remote", "database", "network", "retrieval", "memory", "messaging", "control_plane"]},
          "roles": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 80}},
          "observation_level": {"enum": ["content", "semantic_metadata", "host_provenance"]},
          "bypass_test_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
        }
      }
    },
    "bypasses": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 300}},
    "known_blind_spots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 8, "maxLength": 300}},
    "conformance_fixture_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$", "maxLength": 128}
  }
}
