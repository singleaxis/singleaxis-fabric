{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/schemas/fabric/coverage/v1/capture-manifest-v1.schema.json",
  "title": "fabric.capture-manifest/v1 (draft, spec 049 rev 6)",
  "description": "JSON form of the per-source-epoch capture manifest (a fabric.capture_manifest span with closed attributes). Manifests never consume source sequences: manifest_seq is their own contiguous counter and after_source_sequence their effective position (spec 049 §2.4). The manifest digest is SHA-256 of its spec-029 canonical JSON. Metadata only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "event_id",
    "source_id",
    "source_epoch",
    "emitted_at",
    "sdk",
    "runtime",
    "profile",
    "coverage_profile",
    "identity_mode",
    "pseudonym_mode",
    "content_capture",
    "role_table_version",
    "limits",
    "sequence_unit",
    "clock",
    "capture_points",
    "uncaptured_classes",
    "inputs",
    "manifest_seq",
    "after_source_sequence",
    "chunk_boundaries_retained",
    "spool_encrypted",
    "unsealed_prior_epochs",
    "unsealed_prior_epoch_count",
    "source_auth"
  ],
  "properties": {
    "schema_version": {
      "const": "fabric.capture-manifest/v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "source_id": {
      "type": "string",
      "maxLength": 160
    },
    "source_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9223372036854775807
    },
    "emitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "language",
        "version"
      ],
      "properties": {
        "language": {
          "enum": [
            "python",
            "typescript"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z.+-]{1,64}$"
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "enum": [
            "cpython",
            "pypy",
            "nodejs",
            "other"
          ]
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z.+-]{1,64}$"
        }
      }
    },
    "profile": {
      "enum": [
        "local",
        "production"
      ]
    },
    "coverage_profile": {
      "type": "string",
      "pattern": "^fabric\\.profile\\.[a-z0-9-]+/v[0-9]+$"
    },
    "identity_mode": {
      "enum": [
        "pseudonymous",
        "clear"
      ]
    },
    "pseudonym_mode": {
      "enum": [
        "keyed",
        "unkeyed"
      ]
    },
    "key_id": {
      "type": "string",
      "pattern": "^kid-[0-9a-f]{8}$"
    },
    "capture_policy": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "policy_id",
            "policy_version",
            "policy_digest"
          ],
          "properties": {
            "policy_id": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
            },
            "policy_version": {
              "type": "integer",
              "minimum": 1
            },
            "policy_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "encrypted_store_required": {
              "type": "boolean"
            }
          },
          "description": "`encrypted_store_required` is copied from deployment-policy/v1 `deployment.encrypted_store_required`; `fabric.local-default` is the implicit local policy."
        }
      ]
    },
    "content_capture": {
      "enum": [
        "enabled",
        "disabled",
        "metadata_only"
      ]
    },
    "content_capture_reason": {
      "enum": [
        "missing_capture_policy",
        "missing_id_key",
        "missing_spool_key",
        "not_configured",
        "hook_disabled"
      ]
    },
    "role_table_version": {
      "type": "string",
      "pattern": "^fabric\\.content-role-table/v[0-9]+@[0-9]+$"
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_body_bytes",
        "max_retain_bytes",
        "max_inflight_bytes",
        "queue_max_items",
        "part_min_bytes",
        "records_max_object_bytes",
        "open_run_deadline_s"
      ],
      "properties": {
        "max_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_retain_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "max_inflight_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "queue_max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "part_min_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "records_max_object_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "open_run_deadline_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 31536000
        }
      }
    },
    "sequence_unit": {
      "enum": [
        "exchange",
        "record"
      ]
    },
    "clock": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "domain",
        "uncertainty_ns"
      ],
      "properties": {
        "domain": {
          "const": "wall_utc"
        },
        "uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "max_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "endpoint_set_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "explicit_wins": {
      "type": "boolean"
    },
    "capture_points": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "kind",
          "state",
          "process_global",
          "opt_in",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,63}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9A-Za-z.+-]{1,32}$"
          },
          "kind": {
            "enum": [
              "F",
              "W",
              "H",
              "R",
              "P",
              "I",
              "S"
            ]
          },
          "state": {
            "enum": [
              "active",
              "installed_inactive",
              "disabled",
              "unsupported",
              "failed"
            ]
          },
          "process_global": {
            "type": "boolean"
          },
          "opt_in": {
            "type": "boolean"
          },
          "fields": {
            "type": "array",
            "maxItems": 256,
            "items": {
              "type": "string",
              "pattern": "^[XCSND][0-9]{2}$"
            }
          },
          "reason": {
            "enum": [
              "not_instrumented",
              "hook_disabled",
              "not_configured",
              "unsupported_api",
              "unsupported_runtime",
              "unsupported_version",
              "parse_failed",
              "body_cap",
              "part_cap",
              "inflight_budget",
              "queue_full",
              "disk_full",
              "shutdown",
              "internal_error",
              "span_dropped",
              "store_failed",
              "destination_rejected",
              "transport_incomplete",
              "stream_closed_early",
              "privacy_policy",
              "protection_failed",
              "missing_capture_policy",
              "missing_id_key",
              "missing_spool_key",
              "provider_redacted",
              "provider_encrypted",
              "provider_summarised",
              "provider_not_returned",
              "provider_held",
              "caller_omitted",
              "deferred_to_explicit",
              "explicit_withheld",
              "not_exposed",
              "source_lost",
              "segment_missing",
              "segment_conflict",
              "run_unterminated",
              "post_terminal_activity",
              "clock_uncertain",
              "source_unauthenticated",
              "unsealed_epoch",
              "seal_mismatch",
              "uninstrumented_client",
              "sampling",
              "retention_expired",
              "deleted"
            ]
          }
        }
      }
    },
    "uncaptured_classes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "requests",
          "urllib3",
          "boto3",
          "aiohttp",
          "grpc",
          "websocket",
          "webrtc",
          "node_http",
          "axios",
          "custom_fetch",
          "node_below_24",
          "stdio_mcp",
          "direct_pipe_reads",
          "provider_batch_files",
          "non_post_endpoints",
          "unmatched_endpoints",
          "other_runtime"
        ]
      }
    },
    "manifest_seq": {
      "type": "integer",
      "minimum": 0
    },
    "after_source_sequence": {
      "type": "integer",
      "minimum": -1
    },
    "previous_manifest_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "chunk_boundaries_retained": {
      "type": "boolean"
    },
    "inputs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "enum": [
          "wire",
          "records"
        ]
      }
    },
    "spool_encrypted": {
      "type": "boolean"
    },
    "spool_key_id": {
      "description": "Spec 049 \u00a77.8: the kid- id of the customer key sealing the agent spool (never the key); present only when spool_encrypted is true.",
      "type": "string",
      "pattern": "^kid-[0-9a-f]{8}$"
    },
    "unsealed_prior_epochs": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9223372036854775807
      }
    },
    "unsealed_prior_epoch_count": {
      "type": "integer",
      "minimum": 0
    },
    "source_auth": {
      "enum": [
        "bound",
        "unbound"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_seq": {
            "minimum": 1
          }
        }
      },
      "then": {
        "required": [
          "previous_manifest_sha256"
        ]
      }
    },
    {
      "if": {
        "required": [
          "spool_key_id"
        ]
      },
      "then": {
        "properties": {
          "spool_encrypted": {
            "const": true
          }
        }
      }
    }
  ]
}
