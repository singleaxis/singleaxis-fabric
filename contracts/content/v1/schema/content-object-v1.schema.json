{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.singleaxis.dev/fabric/content/v1/content-object-v1.schema.json",
  "title": "Fabric governed content object descriptor v1",
  "description": "Self-describing descriptor for one immutable governed content object stored in customer-controlled storage. The descriptor travels inside transcript manifests and beside the stored bytes; the digest covers the exact stored byte sequence only.",
  "type": "object",
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "role",
    "media_type",
    "encoding",
    "byte_length",
    "digest",
    "captured_at",
    "representation",
    "source",
    "status",
    "bindings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "fabric.content-object/v1" },
    "object_id": { "$ref": "#/$defs/uuid" },
    "tenant_id": { "$ref": "#/$defs/safeIdentifier" },
    "role": { "$ref": "#/$defs/contentRole" },
    "media_type": { "enum": ["application/json", "text/plain"] },
    "encoding": { "const": "utf-8" },
    "byte_length": { "type": "integer", "minimum": 0 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "captured_at": { "type": "string", "format": "date-time" },
    "representation": {
      "enum": ["captured", "canonicalized", "assembled", "truncated"]
    },
    "original_byte_length": { "type": "integer", "minimum": 0 },
    "source": { "enum": ["caller", "adapter"] },
    "status": { "$ref": "#/$defs/contentStatus" },
    "status_reason": { "type": "string", "maxLength": 512 },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trace_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
        "span_id": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
        "decision_id": { "type": "string", "maxLength": 253 },
        "execution_id": { "type": "string", "maxLength": 253 },
        "session_id": { "type": "string", "maxLength": 253 },
        "request_id": { "type": "string", "maxLength": 253 },
        "step_type": { "type": "string", "maxLength": 64 },
        "step_id": { "type": "string", "maxLength": 253 },
        "step_attempt_id": { "type": "string", "maxLength": 253 },
        "step_attempt": { "type": "integer", "minimum": 1 },
        "tool_call_id": { "type": "string", "maxLength": 253 },
        "parent_tool_call_id": { "type": "string", "maxLength": 253 },
        "related_object_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/uuid" },
          "uniqueItems": true
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "representation": { "const": "truncated" } } },
      "then": { "required": ["original_byte_length"] }
    },
    {
      "if": { "properties": { "status": { "enum": ["failed", "dropped", "unsupported"] } } },
      "then": { "required": ["status_reason"] }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "safeIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,255}$"
    },
    "contentRole": {
      "enum": [
        "model.request.instructions",
        "model.request.messages",
        "model.request.tool_definitions",
        "model.request.parameters",
        "model.output.messages",
        "tool.call.arguments",
        "tool.call.result",
        "retrieval.query",
        "retrieval.results",
        "memory.write.content",
        "memory.read.content",
        "side_effect.request",
        "side_effect.result",
        "context.file",
        "interaction.payload"
      ]
    },
    "contentStatus": {
      "enum": [
        "pending",
        "stored",
        "not_captured",
        "unsupported",
        "truncated",
        "dropped",
        "failed",
        "redacted"
      ]
    }
  }
}
