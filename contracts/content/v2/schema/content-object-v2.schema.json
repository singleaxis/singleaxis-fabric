{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/contracts/content/v2/content-object-v2.schema.json",
  "title": "Fabric governed byte evidence descriptor v2 (draft)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_id",
    "tenant_id",
    "role",
    "media_type",
    "representation",
    "provenance",
    "boundary",
    "source_id",
    "source_epoch",
    "source_sequence",
    "captured_at",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "fabric.content-object/v2"},
    "object_id": {"$ref": "#/$defs/opaqueId"},
    "tenant_id": {"$ref": "#/$defs/opaqueId"},
    "workload_id": {"$ref": "#/$defs/opaqueId"},
    "run_id": {"$ref": "#/$defs/opaqueId"},
    "operation_id": {"$ref": "#/$defs/opaqueId"},
    "attempt_id": {"$ref": "#/$defs/opaqueId"},
    "privacy_mode": {"enum": ["original", "omit", "masked_only", "original_plus_masked", "retain_original", "metadata_only", "redact", "tokenize"]},
    "policy_digest": {"$ref": "#/$defs/digest"},
    "policy_id": {"$ref": "#/$defs/opaqueId"},
    "policy_version": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "protection_status": {"enum": ["withheld", "redacted", "tokenized", "retained", "unsupported", "lost"]},
    "transformation_id": {"$ref": "#/$defs/opaqueId"},
    "transformation_version": {"$ref": "#/$defs/opaqueId"},
    "stream_id": {"$ref": "#/$defs/opaqueId"},
    "chunk_index": {"type": "integer", "minimum": 0},
    "role": {
      "enum": [
        "model.request.instructions", "model.request.messages",
        "model.request.tool_definitions", "model.request.parameters",
        "model.output.messages", "model.exchange.request",
        "model.exchange.response", "tool.definition", "tool.call.arguments",
        "tool.call.result", "retrieval.query", "retrieval.results",
        "memory.write.content", "memory.read.content",
        "side_effect.request", "side_effect.result", "context.file",
        "interaction.payload", "terminal.argv", "terminal.stdin",
        "terminal.stdout", "terminal.stderr", "remote.request",
        "remote.result", "remote.stream", "database.query",
        "database.parameters", "database.rows", "database.mutation",
        "network.request", "network.response", "network.stream",
        "sandbox.config", "sandbox.output", "artifact.before",
        "artifact.after", "service.receipt",
        "model.exchange.part", "model.output.reasoning", "actor.identity",
        "run.trigger", "run.goal", "run.input", "run.permissions",
        "run.configuration", "run.environment", "run.outcome",
        "outcome.delivery", "step.error", "tool.inventory", "agent.handoff",
        "checkpoint.state", "workflow.definition", "mcp.request",
        "mcp.response", "mcp.notification", "mcp.server", "computer.action",
        "computer.snapshot", "control.checked", "control.reason",
        "control.approval", "selection.decision", "context.change",
        "terminal.context", "artifact.diff", "asset.bytes", "media.frames",
        "media.events", "media.transcript", "artifact.locator",
        "record.evidence"
      ]
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+$",
      "maxLength": 128
    },
    "encoding": {"type": "string", "enum": ["utf-8", "binary"]},
    "content_encoding": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._+-]{0,31}(,[a-z0-9][a-z0-9._+-]{0,31}){0,3}$"
    },
    "representation": {
      "enum": ["exact", "canonicalized", "assembled", "partial", "truncated", "redacted", "tokenized", "unavailable", "split"]
    },
    "transformations": {
      "type": "array",
      "items": {"enum": ["utf8_encode", "json_canonicalize", "assemble", "truncate", "redact", "tokenize", "extract_parts"]},
      "uniqueItems": true
    },
    "source_byte_length": {"type": "integer", "minimum": 0},
    "source_sha256": {"$ref": "#/$defs/digest"},
    "stored_byte_length": {"type": "integer", "minimum": 0},
    "stored_sha256": {"$ref": "#/$defs/digest"},
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^(s3|gs|file|fabric-local)://[^@?#]+$"
    },
    "provenance": {"enum": ["native", "protocol", "caller_reported", "inferred"]},
    "boundary": {
      "enum": ["caller", "provider_bound", "tool", "terminal", "sandbox", "remote", "host", "service"]
    },
    "source_id": {"$ref": "#/$defs/opaqueId"},
    "source_epoch": {"type": "integer", "minimum": 0},
    "source_sequence": {"type": "integer", "minimum": 0},
    "captured_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": ["pending", "stored", "truncated", "redacted", "not_captured", "unsupported", "dropped", "failed"]
    },
    "status_reason": {"type": "string", "maxLength": 160},
    "source_authenticated": {
      "description": "Receiver-owned (spec 049 §4.3 rule 6, §7.9): written as true only by the fabriccontent exporter into the persisted descriptor when the record arrived on an ingress bound to its tenant and source, and returned by content readback. An agent-supplied value is rejected.",
      "type": "boolean"
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["relation", "object_id"],
        "properties": {
          "relation": {"enum": ["parent", "derived_from", "request_for", "result_of", "before", "after", "part_of"]},
          "object_id": {"$ref": "#/$defs/opaqueId"},
          "byte_range": {
            "description": "part_of only (spec 049 §7.4-§7.5): the half-open [start, end) byte offsets of this part in the original body, so end - start is the part's stored byte length.",
            "type": "array",
            "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}],
            "minItems": 2,
            "maxItems": 2
          }
        },
        "if": {"properties": {"relation": {"const": "part_of"}}},
        "else": {"not": {"required": ["byte_range"]}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"enum": ["stored", "truncated", "redacted"]}}},
      "then": {"required": ["stored_byte_length", "stored_sha256", "ref"]}
    },
    {
      "if": {"properties": {"status": {"enum": ["not_captured", "unsupported", "dropped", "failed"]}}},
      "then": {
        "not": {
          "anyOf": [
            {"required": ["ref"]},
            {"required": ["stored_sha256"]},
            {"required": ["stored_byte_length"]}
          ]
        }
      }
    },
    {
      "if": {"properties": {"representation": {"const": "exact"}}},
      "then": {"required": ["source_byte_length", "source_sha256"]}
    },
    {
      "if": {"required": ["source_sha256"]},
      "then": {"required": ["source_byte_length"]}
    },
    {
      "if": {"properties": {"representation": {"const": "split"}}, "required": ["representation"]},
      "then": {
        "required": ["source_byte_length", "source_sha256", "transformations"],
        "properties": {"transformations": {"contains": {"const": "extract_parts"}}}
      }
    },
    {
      "if": {"required": ["chunk_index"]},
      "then": {"required": ["stream_id"]}
    },
    {
      "if": {"required": ["ref"], "properties": {"ref": {"pattern": "^fabric-local:"}}},
      "then": {"required": ["workload_id", "policy_digest"]}
    },
    {
      "if": {
        "anyOf": [
          {"required": ["policy_digest"]},
          {"required": ["policy_id"]},
          {"required": ["policy_version"]},
          {"required": ["protection_status"]},
          {"required": ["privacy_mode"], "properties": {"privacy_mode": {"enum": ["metadata_only", "retain_original", "redact", "tokenize", "masked_only", "original_plus_masked"]}}},
          {"properties": {"representation": {"const": "tokenized"}}}
        ]
      },
      "then": {
        "required": ["policy_digest", "policy_id", "policy_version", "privacy_mode", "protection_status"],
        "properties": {"privacy_mode": {"enum": ["omit", "metadata_only", "retain_original", "redact", "tokenize", "masked_only", "original_plus_masked"]}}
      }
    },
    {
      "if": {
        "required": ["policy_digest"],
        "properties": {"privacy_mode": {"enum": ["omit", "metadata_only", "redact", "tokenize", "masked_only"]}}
      },
      "then": {"not": {"required": ["source_sha256"]}}
    },
    {
      "if": {
        "required": ["policy_digest", "privacy_mode"],
        "properties": {"privacy_mode": {"enum": ["omit", "redact", "tokenize", "masked_only"]}}
      },
      "then": {"not": {"required": ["source_byte_length"]}}
    },
    {
      "description": "Spec 049 §7.5/§7.7: the masked review copy of original_plus_masked keeps no digest or length of the original and names the original it masks.",
      "if": {
        "required": ["privacy_mode", "protection_status"],
        "properties": {"privacy_mode": {"const": "original_plus_masked"}, "protection_status": {"const": "redacted"}}
      },
      "then": {
        "not": {"anyOf": [{"required": ["source_sha256"]}, {"required": ["source_byte_length"]}]},
        "required": ["links"],
        "properties": {"links": {"contains": {"properties": {"relation": {"const": "derived_from"}}, "required": ["relation"]}}}
      }
    }
  ],
  "$defs": {
    "opaqueId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
