{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/contracts/capture/v1/run-reconstruction-v1.schema.json",
  "title": "Fabric run reconstruction v1 (draft, spec 047 rev 7, spec 048 rev 3)",
  "description": "Output of python -m fabric.reconstruct. An integrity verdict over captured model exchanges, derived from exchange/loss/heartbeat spans and the exact bytes in the customer store: one verdict per fabric.wire.run() scope (scopes[]) and one per run (runs[]). An unscoped run is judged over its declared scope (final heartbeat rule); a scoped run aggregates the scopes the record holds and is at best complete_for_observed_scopes, because a scope that left no record cannot be claimed. It is not a quality evaluation and carries no content: provider-derived ids appear only as pseudonyms, and neither store locations nor input file paths appear (span files are named by digest).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "verifier", "inputs", "sources", "runs", "scopes"],
  "properties": {
    "schema_version": {"const": "fabric.run-reconstruction/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "fabric.reconstruct"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_files"],
      "properties": {
        "span_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "format", "records"],
            "properties": {
              "sha256": {"$ref": "#/$defs/digest"},
              "format": {"enum": ["sink_jsonl", "otlp_json", "otlp_proto"]},
              "records": {"type": "integer", "minimum": 0}
            }
          }
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tenant_id"],
          "properties": {
            "kind": {"enum": ["local", "s3"]},
            "tenant_id": {"$ref": "#/$defs/opaqueId"}
          }
        },
        "telemetry_origin": {
          "description": "Spec 049 \u00a77.9, decision 20: trusted_readback when the span files are the Node's own telemetry export or destination read from a trusted location; imported otherwise (no record of them is authenticated).",
          "enum": ["trusted_readback", "imported"]
        },
        "evaluated_at": {
          "description": "Spec 050 §3.12: the time run states and deadlines were evaluated at (--evaluated-at; default the run time).",
          "type": "string", "format": "date-time"
        },
        "profile": {
          "description": "Spec 049 \u00a77.3: the deployment profile the verifier evaluated; production requires every record to carry the Node's source stamp.",
          "enum": ["local", "production"]
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "source_epoch", "exchanges", "heartbeat_sequence",
          "missing_sequences", "loss_ranges"
        ],
        "properties": {
          "source_id": {"$ref": "#/$defs/opaqueId"},
          "source_epoch": {"type": "integer", "minimum": 0},
          "exchanges": {"type": "integer", "minimum": 0},
          "heartbeat_sequence": {"type": "integer", "minimum": -1},
          "final_heartbeat_sequence": {
            "description": "Highest last_sequence of a final heartbeat for this epoch, when one was seen.",
            "type": "integer", "minimum": -1
          },
          "missing_sequences": {"type": "array", "items": {"$ref": "#/$defs/range"}},
          "loss_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "first_sequence", "last_sequence", "count"],
              "properties": {
                "reason": {"$ref": "#/$defs/lossReason"},
                "first_sequence": {"type": "integer", "minimum": 0},
                "last_sequence": {"type": "integer", "minimum": 0},
                "count": {"type": "integer", "minimum": 1},
                "segment_id": {"$ref": "#/$defs/segmentId"}
              }
            }
          },
          "manifests": {
            "description": "Spec 050 §3.12: the capture manifests seen for this (source, epoch), in manifest_seq order.",
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest_id", "sha256", "manifest_seq"],
              "properties": {
                "manifest_id": {"$ref": "#/$defs/scopeId"},
                "sha256": {"$ref": "#/$defs/digest"},
                "manifest_seq": {"type": "integer", "minimum": 0}
              }
            }
          },
          "unsealed_epochs": {
            "description": "Spec 050 §3.12 (049 X45): prior epochs of this spool declared unsealed by a manifest 0, or seen only through an orphan heartbeat (a periodic heartbeat for an epoch with no final). A run with a segment there is partial(unsealed_epoch).",
            "type": "array",
            "maxItems": 4096,
            "items": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
          }
        }
      }
    },
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "scopes": {
      "description": "One verdict per fabric.wire.run() scope of every reported run (spec 048 §6, decision H5), in run order. Completeness is claimed per scope: a scope is complete_for_declared_scope only when it is closed by its own markers, holds no missing or conflicting sequence inside its window and every exchange it tags verified. A scope that left no record (its markers and calls all lost before the agent's spool write) cannot appear here.",
      "type": "array",
      "items": {"$ref": "#/$defs/scopeVerdict"}
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "segmentId": {"type": "string", "pattern": "^seg-[0-9a-f]{32}$"},
    "segment": {
      "description": "Spec 050 §3.12: one segment of a run, in the shape of the step projection's run segments (contracts/coverage/v1/schema/step-projection-v1.schema.json).",
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "state", "predecessors"],
      "properties": {
        "segment_id": {"$ref": "#/$defs/segmentId"},
        "source_id": {"type": "string", "maxLength": 160},
        "source_epoch": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "last_sequence": {"type": "integer", "minimum": -1},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "terminal": {"type": "boolean"},
        "predecessors": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 320}},
        "state": {"enum": ["sealed", "unsealed", "missing", "conflict"]},
        "seal_digest": {"$ref": "#/$defs/digest"},
        "declared_branches": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/segmentId"}},
        "branch_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^br-[0-9a-f]{32}$"}},
        "consumes_branch_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^br-[0-9a-f]{32}$"}},
        "resumable": {"type": "boolean"}
      }
    },
    "scopeId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "pseudonym": {
      "description": "A provider-derived id (response, previous-response or tool-call id) as the report carries it. Keyed (spec 049 §2.9 rule 4, v2 type 'provider'): 'p-' + the first 32 hex of HMAC-SHA256(k_provider, value) when the verifier has FABRIC_WIRE_ID_KEY. Legacy unkeyed: 'p-' + the first 16 hex of sha256(value), still readable; the length tells them apart. Equal ids map to equal pseudonyms under one key.",
      "type": "string", "pattern": "^p-(?:[0-9a-f]{16}|[0-9a-f]{32})$"
    },
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "lossReason": {"enum": ["queue_full", "internal_error", "shutdown", "span_dropped", "uninstrumented_client", "disk_full"]},
    "api": {
      "enum": [
        "openai.chat_completions", "openai.responses", "openai.completions",
        "openai.embeddings", "anthropic.messages"
      ]
    },
    "gapType": {
      "enum": [
        "sequence_gap", "loss", "tail_unverified", "missing_object", "digest_mismatch",
        "truncated", "unparsed_exchange", "prefix_break", "unmatched_tool_call",
        "unresolved_previous_response",
        "source_unauthenticated",
        "segment_missing", "segment_conflict", "post_terminal_activity", "run_unterminated",
        "run_open", "seal_mismatch", "unsealed_segment", "unsealed_epoch", "manifest_gap",
        "clock_uncertain"
      ]
    },
    "check": {"enum": ["passed", "failed", "skipped", "not_applicable"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "loss", "tail", "bytes", "stitching"],
      "properties": {
        "sequence": {"$ref": "#/$defs/check"},
        "loss": {"$ref": "#/$defs/check"},
        "tail": {"$ref": "#/$defs/check"},
        "bytes": {"$ref": "#/$defs/check"},
        "stitching": {"$ref": "#/$defs/check"}
      }
    },
    "scopeListing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "source_id", "source_epoch", "state", "exchanges"],
      "properties": {
        "scope_id": {"$ref": "#/$defs/scopeId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "state": {"enum": ["closed", "open", "conflict"]},
        "start_sequence": {"type": "integer", "minimum": -1},
        "end_sequence": {"type": "integer", "minimum": -1},
        "exchanges": {"type": "integer", "minimum": 0}
      }
    },
    "scopeVerdict": {
      "description": "A scope's own verdict: its gaps (sequence, loss, tail and conflict gaps inside its window, and byte/stitching gaps of the exchanges it tags) and its checks. Every gap listed here is also listed by its run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id", "run_id", "source_id", "source_epoch", "state", "exchanges",
        "verdict", "gaps", "checks"
      ],
      "properties": {
        "scope_id": {"$ref": "#/$defs/scopeId"},
        "run_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "state": {"enum": ["closed", "open", "conflict"]},
        "start_sequence": {"type": "integer", "minimum": -1},
        "end_sequence": {"type": "integer", "minimum": -1},
        "exchanges": {"type": "integer", "minimum": 0},
        "verdict": {"enum": ["complete_for_declared_scope", "partial", "unverified"]},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "checks": {"$ref": "#/$defs/checks"}
      }
    },
    "objectCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification"],
      "properties": {
        "object_id": {"$ref": "#/$defs/opaqueId"},
        "sha256": {"$ref": "#/$defs/digest"},
        "byte_length": {"type": "integer", "minimum": 0},
        "verification": {"enum": ["verified", "missing", "digest_mismatch", "not_stored", "not_checked"]}
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchange_id", "source_id", "source_epoch", "source_sequence", "api",
        "started_at", "ended_at", "response_state", "parse_status", "thread_id",
        "tool_call_ids_consumed", "tool_call_ids_emitted", "objects"
      ],
      "properties": {
        "exchange_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "source_sequence": {"type": "integer", "minimum": 0},
        "api": {"$ref": "#/$defs/api"},
        "scope_id": {"$ref": "#/$defs/scopeId"},
        "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "model": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^(?!.*://)[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "response_id": {"$ref": "#/$defs/pseudonym"},
        "previous_response_id": {"$ref": "#/$defs/pseudonym"},
        "response_state": {"enum": ["complete", "closed_early", "error", "abandoned"]},
        "parse_status": {
          "enum": ["ok", "not_json", "undecodable_encoding", "unrecognized_shape", "truncated", "not_checked"]
        },
        "thread_id": {"$ref": "#/$defs/opaqueId"},
        "continues_exchange_id": {"$ref": "#/$defs/opaqueId"},
        "input_message_count": {"type": "integer", "minimum": 0},
        "output_message_count": {"type": "integer", "minimum": 0},
        "tool_call_ids_consumed": {"type": "array", "items": {"$ref": "#/$defs/pseudonym"}},
        "tool_call_ids_emitted": {"type": "array", "items": {"$ref": "#/$defs/pseudonym"}},
        "objects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {"$ref": "#/$defs/objectCheck"},
            "response": {"$ref": "#/$defs/objectCheck"}
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_type", "effect"],
      "properties": {
        "gap_type": {"$ref": "#/$defs/gapType"},
        "effect": {"enum": ["info", "partial", "unverified"]},
        "exchange_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "first_sequence": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0},
        "tool_call_id": {"$ref": "#/$defs/pseudonym"},
        "previous_response_id": {"$ref": "#/$defs/pseudonym"},
        "object_role": {"enum": ["request", "response"]},
        "segment_id": {"$ref": "#/$defs/segmentId"},
        "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
      },
      "dependentRequired": {
        "first_sequence": ["source_id", "source_epoch", "last_sequence"],
        "last_sequence": ["first_sequence"]
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_epoch", "first_sequence", "last_sequence", "heartbeat_sequence"],
      "properties": {
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "first_sequence": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0},
        "heartbeat_sequence": {"type": "integer", "minimum": -1},
        "scope_id": {
          "description": "Present when the window is one fabric.wire.run() scope (spec 048 §6): first_sequence is its run_start last_sequence + 1 and last_sequence its run_end last_sequence.",
          "$ref": "#/$defs/scopeId"
        },
        "closed_by": {
          "description": "The evidence that proves this window's end: the run's own run_start/run_end markers, or (for a run without markers) the epoch's final heartbeat. Absent when the end is not proven.",
          "enum": ["run_markers", "final_heartbeat"]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "verdict", "declared_scope", "exchanges", "threads", "gaps", "counts", "checks"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/opaqueId"},
        "verdict": {
          "description": "complete_for_declared_scope only for a run without scopes (final heartbeat rule); a run with scopes is at best complete_for_observed_scopes and never better than its worst scope.",
          "enum": ["complete_for_declared_scope", "complete_for_observed_scopes", "partial", "unverified"]
        },
        "declared_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windows"],
          "properties": {
            "windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/window"}}
          }
        },
        "scopes": {
          "description": "Every fabric.wire.run() scope seen for this run id (spec 048 §6); each one's verdict is in the top-level scopes[]. A complete run has only closed scopes.",
          "type": "array",
          "items": {"$ref": "#/$defs/scopeListing"}
        },
        "exchanges": {"type": "array", "items": {"$ref": "#/$defs/exchange"}},
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["thread_id", "exchange_ids"],
            "properties": {
              "thread_id": {"$ref": "#/$defs/opaqueId"},
              "exchange_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/opaqueId"}}
            }
          }
        },
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exchanges", "gaps_by_type"],
          "properties": {
            "exchanges": {"type": "integer", "minimum": 0},
            "gaps_by_type": {
              "type": "object",
              "propertyNames": {"$ref": "#/$defs/gapType"},
              "additionalProperties": {"type": "integer", "minimum": 1}
            }
          }
        },
        "checks": {"$ref": "#/$defs/checks"},
        "run_state": {
          "description": "Spec 050 §3.12 (049 §2.10 G1-G10): absent for pre-P1 captures. The exit code is 0 only when every run is complete and its run_state is absent or terminated; the run_open gap (effect info) does not count in the verdict (spec 050 §9 delta 5).",
          "enum": ["terminated", "open", "unterminated", "conflicted", "not_resumable_unclosed", "deadline_uncertain"]
        },
        "segments": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/segment"}},
        "run_aliases": {
          "description": "Run ids merged into this run: caller_join fan-in (union-find over segment ids) and legacy predecessor union (spec 050 §3.12).",
          "type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaqueId"}
        },
        "id_basis_conflicts": {
          "description": "Segments whose run_start joined tokens of different runs without a caller run id (id_basis token_conflict), with the run ids its tokens named; each is also a segment_conflict gap.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_id", "run_ids"],
            "properties": {
              "segment_id": {"$ref": "#/$defs/segmentId"},
              "run_ids": {"type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}}
            }
          }
        },
        "deadline_at": {"type": "string", "format": "date-time"},
        "evaluated_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
