{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/contracts/capture/v1/run-reconstruction-v1.schema.json",
  "title": "Fabric run reconstruction v1 (draft, spec 047 rev 7, spec 048 rev 3)",
  "description": "Output of python -m fabric.reconstruct. An integrity verdict over captured model exchanges, derived from exchange/loss/heartbeat spans and the exact bytes in the customer store: one verdict per fabric.wire.run() scope (scopes[]) and one per run (runs[]). An unscoped run is judged over its declared scope (final heartbeat rule); a scoped run aggregates the scopes the record holds and is at best complete_for_observed_scopes, because a scope that left no record cannot be claimed. It is not a quality evaluation and carries no content: provider-derived ids appear only as pseudonyms, and neither store locations nor input file paths appear (span files are named by digest).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generated_at", "verifier", "inputs", "sources", "runs", "scopes"],
  "properties": {
    "schema_version": {"const": "fabric.run-reconstruction/v1"},
    "generated_at": {"type": "string", "format": "date-time"},
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"const": "fabric.reconstruct"},
        "version": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_files"],
      "properties": {
        "span_files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sha256", "format", "records"],
            "properties": {
              "sha256": {"$ref": "#/$defs/digest"},
              "format": {"enum": ["sink_jsonl", "otlp_json", "otlp_proto"]},
              "records": {"type": "integer", "minimum": 0}
            }
          }
        },
        "store": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "tenant_id"],
          "properties": {
            "kind": {"enum": ["local", "s3"]},
            "tenant_id": {"$ref": "#/$defs/opaqueId"}
          }
        },
        "telemetry_origin": {
          "description": "Spec 049 \u00a77.9, decision 20: trusted_readback when the span files are the Node's own telemetry export or destination read from a trusted location; imported otherwise (no record of them is authenticated).",
          "enum": ["trusted_readback", "imported"]
        },
        "evaluated_at": {
          "description": "Spec 050 §3.12: the time run states and deadlines were evaluated at (--evaluated-at; default the run time).",
          "type": "string", "format": "date-time"
        },
        "profile": {
          "description": "Spec 049 \u00a77.3: the deployment profile the verifier evaluated; production requires every record to carry the Node's source stamp.",
          "enum": ["local", "production"]
        },
        "derivation": {
          "description": "Spec 057 P1 (WP7-4 to WP7-6): the opt-in wire derivation rules the reader applied to the stored model-call bytes (--derive, --tool-result-markers). Absent when none was asked; every run is then reported as without them (spec 057 §9.1). The denial-marker list is described by its size, digest and refusals only, never by its strings (§7.1, §7.3).",
          "type": "object",
          "additionalProperties": false,
          "required": ["rules"],
          "properties": {
            "rules": {
              "type": "array",
              "uniqueItems": true,
              "maxItems": 4,
              "items": {"enum": ["wire.offered_grant", "wire.safety_map", "wire.tool_result_flag", "wire.tool_result_marker"]}
            },
            "tool_result_markers": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "count", "loaded"],
              "properties": {
                "status": {"enum": ["active", "refused"]},
                "count": {"type": "integer", "minimum": 0},
                "loaded": {"type": "integer", "minimum": 0, "maximum": 256},
                "sha256": {"$ref": "#/$defs/digest"},
                "refused": {
                  "type": "array",
                  "maxItems": 257,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["index", "reason"],
                    "properties": {
                      "index": {"type": "integer", "minimum": 0},
                      "reason": {"enum": ["decision_allow", "invalid", "over_limit"]}
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id", "source_epoch", "exchanges", "heartbeat_sequence",
          "missing_sequences", "loss_ranges"
        ],
        "properties": {
          "source_id": {"$ref": "#/$defs/opaqueId"},
          "source_epoch": {"type": "integer", "minimum": 0},
          "exchanges": {"type": "integer", "minimum": 0},
          "heartbeat_sequence": {"type": "integer", "minimum": -1},
          "final_heartbeat_sequence": {
            "description": "Highest last_sequence of a final heartbeat for this epoch, when one was seen.",
            "type": "integer", "minimum": -1
          },
          "duplicate_records": {
            "description": "Spans of this epoch whose fabric.event_id was already seen: records delivered more than once (delivery is at-least-once; destinations deduplicate by fabric.event_id). Each record counts once everywhere else; this is a count, never a gap or a verdict change. Absent when zero.",
            "type": "integer", "minimum": 1
          },
          "missing_sequences": {"type": "array", "items": {"$ref": "#/$defs/range"}},
          "loss_ranges": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["reason", "first_sequence", "last_sequence", "count"],
              "properties": {
                "reason": {"$ref": "#/$defs/lossReason"},
                "first_sequence": {"type": "integer", "minimum": 0},
                "last_sequence": {"type": "integer", "minimum": 0},
                "count": {"type": "integer", "minimum": 1},
                "segment_id": {"$ref": "#/$defs/segmentId"}
              }
            }
          },
          "manifests": {
            "description": "Spec 050 §3.12: the capture manifests seen for this (source, epoch), in manifest_seq order.",
            "type": "array",
            "maxItems": 4096,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["manifest_id", "sha256", "manifest_seq"],
              "properties": {
                "manifest_id": {"$ref": "#/$defs/scopeId"},
                "sha256": {"$ref": "#/$defs/digest"},
                "manifest_seq": {"type": "integer", "minimum": 0}
              }
            }
          },
          "unsealed_epochs": {
            "description": "Spec 050 §3.12 (049 X45): prior epochs of this spool declared unsealed by a manifest 0, or seen only through an orphan heartbeat (a periodic heartbeat for an epoch with no final). A run with a segment there is partial(unsealed_epoch).",
            "type": "array",
            "maxItems": 4096,
            "items": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807}
          }
        }
      }
    },
    "runs": {"type": "array", "items": {"$ref": "#/$defs/run"}},
    "scopes": {
      "description": "One verdict per fabric.wire.run() scope of every reported run (spec 048 §6, decision H5), in run order. Completeness is claimed per scope: a scope is complete_for_declared_scope only when it is closed by its own markers, holds no missing or conflicting sequence inside its window and every exchange it tags verified. A scope that left no record (its markers and calls all lost before the agent's spool write) cannot appear here.",
      "type": "array",
      "items": {"$ref": "#/$defs/scopeVerdict"}
    },
    "unattributed_host_events": {
      "description": "Spec 056 §4.3 'Host events in no run': every host event of a host source that no run lists (sensor_events, unexplained_host_events) or counts (sandbox_events_unlinked), so captured host activity is never dropped silently. Present when a host source is configured and every run was reconstructed (absent with --run). reasons: other_process (inside a run's window with the agent's pids but another process, or its descendant: H4 agent identity), out_of_scope (inside a run's window, outside the agent's scope), no_run (inside no run's window, both clock margins applied). events lists the first 64 in time order; count is exact. It bounds no run verdict.",
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "reasons", "events"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "reasons": {
          "type": "object",
          "additionalProperties": false,
          "required": ["other_process", "out_of_scope", "no_run"],
          "properties": {
            "other_process": {"type": "integer", "minimum": 0},
            "out_of_scope": {"type": "integer", "minimum": 0},
            "no_run": {"type": "integer", "minimum": 0}
          }
        },
        "events": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["event_id", "source", "event_class", "pid", "time_ns", "reason"],
            "properties": {
              "event_id": {"$ref": "#/$defs/hostEventId"},
              "source": {"enum": ["host.ebpf", "host.auditd"]},
              "event_class": {"enum": ["exec", "connect", "file"]},
              "pid": {"type": "integer", "minimum": 1},
              "time_ns": {"type": "integer", "minimum": 0},
              "reason": {"enum": ["other_process", "out_of_scope", "no_run"]}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "opaqueId": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "segmentId": {"type": "string", "pattern": "^seg-[0-9a-f]{32}$"},
    "segment": {
      "description": "Spec 050 §3.12: one segment of a run, in the shape of the step projection's run segments (contracts/coverage/v1/schema/step-projection-v1.schema.json).",
      "type": "object",
      "additionalProperties": false,
      "required": ["segment_id", "state", "predecessors"],
      "properties": {
        "segment_id": {"$ref": "#/$defs/segmentId"},
        "source_id": {"type": "string", "maxLength": 160},
        "source_epoch": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
        "last_sequence": {"type": "integer", "minimum": -1},
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "terminal": {"type": "boolean"},
        "predecessors": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 320}},
        "state": {"enum": ["sealed", "unsealed", "missing", "conflict"]},
        "seal_digest": {"$ref": "#/$defs/digest"},
        "declared_branches": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/segmentId"}},
        "branch_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^br-[0-9a-f]{32}$"}},
        "consumes_branch_ids": {"type": "array", "maxItems": 64, "items": {"type": "string", "pattern": "^br-[0-9a-f]{32}$"}},
        "resumable": {"type": "boolean"}
      }
    },
    "scopeId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "pseudonym": {
      "description": "A provider-derived id (response, previous-response or tool-call id) as the report carries it. Keyed (spec 049 §2.9 rule 4, v2 type 'provider'): 'p-' + the first 32 hex of HMAC-SHA256(k_provider, value) when the verifier has FABRIC_WIRE_ID_KEY. Legacy unkeyed: 'p-' + the first 16 hex of sha256(value), still readable; the length tells them apart. Equal ids map to equal pseudonyms under one key.",
      "type": "string", "pattern": "^p-(?:[0-9a-f]{16}|[0-9a-f]{32})$"
    },
    "range": {
      "type": "array",
      "prefixItems": [
        {"type": "integer", "minimum": 0},
        {"type": "integer", "minimum": 0}
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "lossReason": {"enum": ["queue_full", "internal_error", "shutdown", "span_dropped", "uninstrumented_client", "disk_full", "destination_rejected"]},
    "api": {
      "enum": [
        "openai.chat_completions", "openai.responses", "openai.completions",
        "openai.embeddings", "anthropic.messages"
      ]
    },
    "gapType": {
      "enum": [
        "sequence_gap", "loss", "tail_unverified", "missing_object", "digest_mismatch",
        "truncated", "unparsed_exchange", "prefix_break", "unmatched_tool_call",
        "unresolved_previous_response",
        "source_unauthenticated",
        "segment_missing", "segment_conflict", "post_terminal_activity", "run_unterminated",
        "run_open", "seal_mismatch", "unsealed_segment", "unsealed_epoch", "manifest_gap",
        "clock_uncertain"
      ]
    },
    "check": {"enum": ["passed", "failed", "skipped", "not_applicable"]},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "loss", "tail", "bytes", "stitching"],
      "properties": {
        "sequence": {"$ref": "#/$defs/check"},
        "loss": {"$ref": "#/$defs/check"},
        "tail": {"$ref": "#/$defs/check"},
        "bytes": {"$ref": "#/$defs/check"},
        "stitching": {"$ref": "#/$defs/check"}
      }
    },
    "scopeListing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope_id", "source_id", "source_epoch", "state", "exchanges"],
      "properties": {
        "scope_id": {"$ref": "#/$defs/scopeId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "state": {"enum": ["closed", "open", "conflict"]},
        "start_sequence": {"type": "integer", "minimum": -1},
        "end_sequence": {"type": "integer", "minimum": -1},
        "exchanges": {"type": "integer", "minimum": 0}
      }
    },
    "scopeVerdict": {
      "description": "A scope's own verdict: its gaps (sequence, loss, tail and conflict gaps inside its window, and byte/stitching gaps of the exchanges it tags) and its checks. Every gap listed here is also listed by its run.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_id", "run_id", "source_id", "source_epoch", "state", "exchanges",
        "verdict", "gaps", "checks"
      ],
      "properties": {
        "scope_id": {"$ref": "#/$defs/scopeId"},
        "run_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "state": {"enum": ["closed", "open", "conflict"]},
        "start_sequence": {"type": "integer", "minimum": -1},
        "end_sequence": {"type": "integer", "minimum": -1},
        "exchanges": {"type": "integer", "minimum": 0},
        "verdict": {"enum": ["complete_for_declared_scope", "partial", "unverified"]},
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "checks": {"$ref": "#/$defs/checks"}
      }
    },
    "objectCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification"],
      "properties": {
        "object_id": {"$ref": "#/$defs/opaqueId"},
        "sha256": {"$ref": "#/$defs/digest"},
        "byte_length": {"type": "integer", "minimum": 0},
        "verification": {"enum": ["verified", "missing", "digest_mismatch", "not_stored", "not_checked"]}
      }
    },
    "exchange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exchange_id", "source_id", "source_epoch", "source_sequence", "api",
        "started_at", "ended_at", "response_state", "parse_status", "thread_id",
        "tool_call_ids_consumed", "tool_call_ids_emitted", "objects"
      ],
      "properties": {
        "exchange_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "source_sequence": {"type": "integer", "minimum": 0},
        "api": {"$ref": "#/$defs/api"},
        "scope_id": {"$ref": "#/$defs/scopeId"},
        "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
        "span_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
        "started_at": {"type": "string", "format": "date-time"},
        "ended_at": {"type": "string", "format": "date-time"},
        "model": {
          "type": "string", "minLength": 1, "maxLength": 128,
          "pattern": "^(?!.*://)[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        },
        "response_id": {"$ref": "#/$defs/pseudonym"},
        "previous_response_id": {"$ref": "#/$defs/pseudonym"},
        "response_state": {"enum": ["complete", "closed_early", "error", "abandoned"]},
        "parse_status": {
          "enum": ["ok", "not_json", "undecodable_encoding", "unrecognized_shape", "truncated", "not_checked"]
        },
        "thread_id": {"$ref": "#/$defs/opaqueId"},
        "continues_exchange_id": {"$ref": "#/$defs/opaqueId"},
        "input_message_count": {"type": "integer", "minimum": 0},
        "output_message_count": {"type": "integer", "minimum": 0},
        "tool_call_ids_consumed": {"type": "array", "items": {"$ref": "#/$defs/pseudonym"}},
        "tool_call_ids_emitted": {"type": "array", "items": {"$ref": "#/$defs/pseudonym"}},
        "objects": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "request": {"$ref": "#/$defs/objectCheck"},
            "response": {"$ref": "#/$defs/objectCheck"}
          }
        }
      }
    },
    "gap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gap_type", "effect"],
      "properties": {
        "gap_type": {"$ref": "#/$defs/gapType"},
        "effect": {"enum": ["info", "partial", "unverified"]},
        "exchange_id": {"$ref": "#/$defs/opaqueId"},
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "first_sequence": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0},
        "tool_call_id": {"$ref": "#/$defs/pseudonym"},
        "previous_response_id": {"$ref": "#/$defs/pseudonym"},
        "object_role": {"enum": ["request", "response"]},
        "segment_id": {"$ref": "#/$defs/segmentId"},
        "reason": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"}
      },
      "dependentRequired": {
        "first_sequence": ["source_id", "source_epoch", "last_sequence"],
        "last_sequence": ["first_sequence"]
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_epoch", "first_sequence", "last_sequence", "heartbeat_sequence"],
      "properties": {
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0},
        "first_sequence": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0},
        "heartbeat_sequence": {"type": "integer", "minimum": -1},
        "scope_id": {
          "description": "Present when the window is one fabric.wire.run() scope (spec 048 §6): first_sequence is its run_start last_sequence + 1 and last_sequence its run_end last_sequence.",
          "$ref": "#/$defs/scopeId"
        },
        "closed_by": {
          "description": "The evidence that proves this window's end: the run's own run_start/run_end markers, or (for a run without markers) the epoch's final heartbeat. Absent when the end is not proven.",
          "enum": ["run_markers", "final_heartbeat"]
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id", "verdict", "declared_scope", "exchanges", "threads", "gaps", "counts", "checks"
      ],
      "properties": {
        "run_id": {"$ref": "#/$defs/opaqueId"},
        "verdict": {
          "description": "complete_for_declared_scope only for a run without scopes (final heartbeat rule); a run with scopes is at best complete_for_observed_scopes and never better than its worst scope.",
          "enum": ["complete_for_declared_scope", "complete_for_observed_scopes", "partial", "unverified"]
        },
        "declared_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windows"],
          "properties": {
            "windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/window"}}
          }
        },
        "scopes": {
          "description": "Every fabric.wire.run() scope seen for this run id (spec 048 §6); each one's verdict is in the top-level scopes[]. A complete run has only closed scopes.",
          "type": "array",
          "items": {"$ref": "#/$defs/scopeListing"}
        },
        "exchanges": {"type": "array", "items": {"$ref": "#/$defs/exchange"}},
        "threads": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["thread_id", "exchange_ids"],
            "properties": {
              "thread_id": {"$ref": "#/$defs/opaqueId"},
              "exchange_ids": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/opaqueId"}}
            }
          }
        },
        "gaps": {"type": "array", "items": {"$ref": "#/$defs/gap"}},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["exchanges", "gaps_by_type"],
          "properties": {
            "exchanges": {"type": "integer", "minimum": 0},
            "gaps_by_type": {
              "type": "object",
              "propertyNames": {"$ref": "#/$defs/gapType"},
              "additionalProperties": {"type": "integer", "minimum": 1}
            }
          }
        },
        "checks": {"$ref": "#/$defs/checks"},
        "run_state": {
          "description": "Spec 050 §3.12 (049 §2.10 G1-G10): absent for pre-P1 captures. The exit code is 0 only when every run is complete and its run_state is absent or terminated; the run_open gap (effect info) does not count in the verdict (spec 050 §9 delta 5).",
          "enum": ["terminated", "open", "unterminated", "conflicted", "not_resumable_unclosed", "deadline_uncertain"]
        },
        "segments": {"type": "array", "maxItems": 4096, "items": {"$ref": "#/$defs/segment"}},
        "run_aliases": {
          "description": "Run ids merged into this run: caller_join fan-in (union-find over segment ids) and legacy predecessor union (spec 050 §3.12).",
          "type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/opaqueId"}
        },
        "id_basis_conflicts": {
          "description": "Segments whose run_start joined tokens of different runs without a caller run id (id_basis token_conflict), with the run ids its tokens named; each is also a segment_conflict gap.",
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["segment_id", "run_ids"],
            "properties": {
              "segment_id": {"$ref": "#/$defs/segmentId"},
              "run_ids": {"type": "array", "minItems": 2, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/opaqueId"}}
            }
          }
        },
        "deadline_at": {"type": "string", "format": "date-time"},
        "evaluated_at": {"type": "string", "format": "date-time"},
        "attempts": {
          "description": "Spec 050 §3.12 (WP-30): the complete position set of every records-input attempt of the run. The step projection lists at most 64 event_ids per step (collection/continuation); this keeps the full membership: per attempt its fabric.attempt.uid, its step id when the records carry one, the number of positions and, per (source, epoch), the positions as ascending, disjoint, non-adjacent [first, last] ranges.",
          "type": "array",
          "maxItems": 1000000,
          "items": {"$ref": "#/$defs/attempt"}
        },
        "chains": {
          "description": "Spec 056 §4.5: one verdict per evidence chain. decisions is the exchange-only verdict; it is not_observed, without reasons, only for a run with no captured exchange whose record verifies (an effects-only process, such as a tool worker), never for a run with an exchange. actions, effects and corroboration are not_observed when the run has no tool calls, no enabled effect channel or no host source. The run verdict is never complete while a chain is partial or unverified.",
          "type": "object",
          "additionalProperties": false,
          "required": ["decisions", "actions", "effects", "corroboration"],
          "properties": {
            "decisions": {"allOf": [{"$ref": "#/$defs/chainVerdict"}, {"if": {"properties": {"verdict": {"const": "not_observed"}}, "required": ["verdict"]}, "then": {"not": {"required": ["reasons"]}}}]},
            "actions": {"$ref": "#/$defs/chainVerdict"},
            "effects": {"$ref": "#/$defs/chainVerdict"},
            "corroboration": {"$ref": "#/$defs/chainVerdict"},
            "controls": {"$ref": "#/$defs/controlsChainVerdict"}
          }
        },
        "attribution": {"$ref": "#/$defs/attribution"},
        "security_context": {"$ref": "#/$defs/securityContext"},
        "sensor_events": {
          "description": "Spec 053 §6.3, spec 056 §4.3: the host-sensor events a link of this run names (as a target or a candidate of an agent step's corroborated_by link, or as the subject of a part_of link), with the links whose subject they are (H3 process_lineage to an anchored effect, H4 process_anchor to the run, M2 H5 sandbox_report to the effect that reported the event's container or pod id). Never a peer address, path or argv: ids, pids and times only.",
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/sensorEvent"}
        }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_uid", "records", "sequences"],
      "properties": {
        "attempt_uid": {"$ref": "#/$defs/scopeId"},
        "step_id": {"$ref": "#/$defs/opaqueId"},
        "records": {"type": "integer", "minimum": 1},
        "sequences": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_epoch", "ranges"],
            "properties": {
              "source_id": {"$ref": "#/$defs/opaqueId"},
              "source_epoch": {"type": "integer", "minimum": 0},
              "ranges": {"type": "array", "minItems": 1, "maxItems": 1000000, "items": {"$ref": "#/$defs/range"}}
            }
          }
        }
      }
    },
    "chainReason": {
      "description": "Spec 056 §4.5: a chain's partial, unverified or not_observed reason: a gap type of this report, or a coverage reason (contracts/coverage/v1 vocabularies reason, which holds the 056 chain reasons). The validator pins this enum to both.",
      "enum": ["sequence_gap", "loss", "tail_unverified", "missing_object", "digest_mismatch", "truncated", "unparsed_exchange", "prefix_break", "unmatched_tool_call", "unresolved_previous_response", "source_unauthenticated", "segment_missing", "segment_conflict", "post_terminal_activity", "run_unterminated", "run_open", "seal_mismatch", "unsealed_segment", "unsealed_epoch", "manifest_gap", "clock_uncertain", "not_instrumented", "hook_disabled", "not_configured", "unsupported_api", "unsupported_runtime", "unsupported_version", "parse_failed", "body_cap", "part_cap", "inflight_budget", "queue_full", "disk_full", "shutdown", "internal_error", "span_dropped", "store_failed", "destination_rejected", "transport_incomplete", "stream_closed_early", "privacy_policy", "protection_failed", "missing_capture_policy", "missing_id_key", "missing_spool_key", "provider_redacted", "provider_encrypted", "provider_summarised", "provider_not_returned", "provider_held", "caller_omitted", "deferred_to_explicit", "explicit_withheld", "not_exposed", "source_lost", "uninstrumented_client", "sampling", "retention_expired", "deleted", "unattributed_effect", "ambiguous_attribution", "tool_result_missing", "exchange_gap", "source_gap", "anchor_missing", "unexplained_host_event", "channel_disabled", "no_effect_channel", "none_in_window", "remote_sandbox"]
    },
    "chainVerdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": {"enum": ["complete", "partial", "unverified", "not_observed"]},
        "reasons": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/chainReason"}}
      }
    },
    "controlsChainVerdict": {
      "description": "Spec 057 §6.4 (OD-17): the fifth chain, reported like the other four and optional until the reader emits it. not_observed: no control, grant, hook or extension capture point or derivation rule is active and the run has none of these records. complete means the controls Fabric observed or was told about are consistent and joined, never that every control in the customer's system was recorded. Reasons are the controls_chain_reason vocabulary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["verdict"],
      "properties": {
        "verdict": {"enum": ["complete", "partial", "unverified", "not_observed"]},
        "reasons": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"enum": ["control_unmatched", "control_pending_at_end", "ambiguous_attribution", "grant_not_recorded", "body_not_retained", "sequence_gap", "invariant_conflict"]}}
      }
    },
    "count": {"type": "integer", "minimum": 0},
    "securityContext": {
      "description": "Spec 057 §6.4: counts only, never a value. Grants by basis; controls by kind, decision and derivation and by link method; hooks by basis and outcome; extensions by kind, observed_via and signature status; the mechanical facts F1-F14 (security_fact vocabulary) with their first 64 event ids. A fact is co-occurrence, never a violation.",
      "type": "object",
      "additionalProperties": false,
      "required": ["grants", "controls", "control_links", "hooks", "extensions", "facts"],
      "properties": {
        "grants": {"type": "object", "additionalProperties": false, "required": ["offered", "listed", "declared"], "properties": {"offered": {"$ref": "#/$defs/count"}, "listed": {"$ref": "#/$defs/count"}, "declared": {"$ref": "#/$defs/count"}}},
        "controls": {"type": "array", "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "decision", "derivation", "count"], "properties": {"kind": {"enum": ["guardrail", "policy", "permission_request", "approval", "rate_limit", "budget", "other", "provider_safety", "elicitation", "os_access", "permission_check"]}, "decision": {"enum": ["allow", "deny", "modify", "escalate", "pending", "timeout", "cancelled", "revoked", "unknown", "error"]}, "derivation": {"enum": ["literal", "configured_extract", "configured_marker", "configured_exit_map", "reported", "wrapped_check"]}, "count": {"type": "integer", "minimum": 1}}}},
        "control_links": {"type": "object", "additionalProperties": false, "propertyNames": {"enum": ["provider_id", "exchange_id", "mcp_session", "rpc_id", "reported_ref", "ref_join", "sequence_bracket", "process_anchor", "pending_single", "pending_set", "path_ref", "none"]}, "patternProperties": {"^[a-z_]+$": {"$ref": "#/$defs/count"}}},
        "hooks": {"type": "array", "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["basis", "outcome", "count"], "properties": {"basis": {"enum": ["process", "callback", "reported_unknown"]}, "outcome": {"enum": ["passed", "modified", "blocked", "escalated", "errored", "unknown"]}, "count": {"type": "integer", "minimum": 1}}}},
        "extensions": {"type": "array", "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["kind", "observed_via", "signature_status", "count"], "properties": {"kind": {"enum": ["skill", "plugin", "mcp_server", "hook_bundle", "subagent", "tool_pack", "other"]}, "observed_via": {"enum": ["mcp_initialize", "mcp_tools_list", "process_launch", "path_open", "reported"]}, "signature_status": {"enum": ["verified", "invalid", "unsigned", "unverified", "unknown"]}, "count": {"type": "integer", "minimum": 1}}}},
        "grant_in_force": {"description": "Spec 057 §6.1 (revision 3.6): present only when the run holds a grant snapshot. Of the run's control rows and tool calls, how many have their latest earlier snapshot reported (records API or telemetry), observed (derived from model-wire bytes) or none before them; ambiguous counts the rows, among reported and observed, whose earlier snapshots come from sources that cannot be ordered.", "type": "object", "additionalProperties": false, "required": ["reported", "observed", "none", "ambiguous"], "properties": {"reported": {"$ref": "#/$defs/count"}, "observed": {"$ref": "#/$defs/count"}, "none": {"$ref": "#/$defs/count"}, "ambiguous": {"$ref": "#/$defs/count"}}},
        "facts": {"type": "array", "maxItems": 15, "items": {"type": "object", "additionalProperties": false, "required": ["code", "count", "event_ids"], "properties": {"code": {"enum": ["no_declared_grant", "grant_changed", "control_unmatched", "control_pending_at_end", "control_denied", "deny_with_effect", "approval_required_without_decision", "hook_errored", "hook_modified", "extension_signature", "control_invariant_conflict", "inventory_changed", "tool_called_not_offered", "os_denied", "tool_result_error"]}, "count": {"type": "integer", "minimum": 1}, "event_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}}}}}
      }
    },
    "hostEventId": {
      "description": "Spec 056 §4.3: a host event's id. fabric.event_id (uuid4) on a spec 053 §6.2.3 host record; on a local-profile audit-class log record, log.record.uid (host- + 32 hex, eBPF emitter), rec- + fabric.record_id (auditd logfile), else hev- + the first 32 hex of the SHA-256 of the record's canonical JSON (contracts/coverage/v1/fixtures/action-record/README.md).",
      "type": "string",
      "pattern": "^(?:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}|host-[0-9a-f]{32}|rec-[0-9a-f]{64}|hev-[0-9a-f]{32})$"
    },
    "actionLink": {
      "description": "A spec 056 link whose subject is a host event: the step-projection link shape (contracts/coverage/v1 step-projection-v1 $defs/link) narrowed to the 056 rules. M2 (rule H5): sandbox_report is the one reported method; its provenance is reported (the container runtime printed the id in the effect's output) and its confidence certain.",
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "target", "provenance", "method", "confidence", "state"],
      "properties": {
        "type": {"enum": ["part_of"]},
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["namespace", "id"],
          "properties": {
            "namespace": {"enum": ["attempt", "run"]},
            "id": {"type": "string", "minLength": 1, "maxLength": 256}
          }
        },
        "provenance": {"enum": ["inferred", "reported"]},
        "method": {"enum": ["process_anchor", "process_lineage", "sandbox_report"]},
        "confidence": {"enum": ["certain", "tentative"]},
        "state": {"enum": ["resolved", "ambiguous"]},
        "candidates": {"type": "array", "minItems": 2, "maxItems": 64, "items": {"type": "string", "maxLength": 256}}
      },
      "if": {"properties": {"method": {"const": "sandbox_report"}}},
      "then": {"properties": {"provenance": {"const": "reported"}, "confidence": {"const": "certain"}, "state": {"const": "resolved"}}},
      "else": {"properties": {"provenance": {"const": "inferred"}}}
    },
    "sensorEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_id", "source", "event_class", "pid", "time_ns"],
      "properties": {
        "event_id": {"$ref": "#/$defs/hostEventId"},
        "source": {"enum": ["host.ebpf", "host.auditd"]},
        "event_class": {"enum": ["exec", "connect", "file"]},
        "pid": {"type": "integer", "minimum": 1},
        "ppid": {"type": "integer", "minimum": 0},
        "time_ns": {"type": "integer", "minimum": 0},
        "process_start_ns": {"type": "integer", "minimum": 0},
        "links": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/actionLink"}}
      }
    },
    "attribution": {
      "description": "Spec 056 §4.5: the attribution summary. links counts each effect's or host event's decision by basis (reported is A0, none is A4; an S0 startup effect is not counted; process_anchor counts H1, H2, H4 and effects with a pid that no event anchors as unresolved; sandbox_report counts H5 links, M2). unattributed_effects and unexplained_host_events list at most the first 64 in sequence or time order with the full count. effects_not_observed counts the tool calls with no attributed effect by reason. lineage_truncated counts host events an H3 depth or count bound left unlinked. M2: sandbox_events_unlinked counts the sandbox-scope host events no H5 link names (never listed as unexplained); remote_sandbox_calls lists the H4 connect events of the agent process to a declared sandbox peer while the remote.sandbox capture point is not active (the first 64 in time order, with the full count).",
      "type": "object",
      "additionalProperties": false,
      "required": ["links", "unattributed_effects", "effects_not_observed", "output_match", "unexplained_host_events"],
      "properties": {
        "links": {
          "type": "object",
          "propertyNames": {"enum": ["reported", "output_match", "sequence_bracket", "process_anchor", "process_lineage", "sandbox_report", "none"]},
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resolved", "ambiguous", "unresolved"],
            "properties": {
              "resolved": {"type": "integer", "minimum": 0},
              "ambiguous": {"type": "integer", "minimum": 0},
              "unresolved": {"type": "integer", "minimum": 0}
            }
          }
        },
        "unattributed_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "effects"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "effects": {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attempt_uid", "event_id"],
                "properties": {"attempt_uid": {"$ref": "#/$defs/scopeId"}, "event_id": {"$ref": "#/$defs/scopeId"}}
              }
            }
          }
        },
        "effects_not_observed": {
          "type": "object",
          "additionalProperties": false,
          "required": ["channel_disabled", "no_effect_channel", "none_in_window"],
          "properties": {
            "channel_disabled": {"type": "integer", "minimum": 0},
            "no_effect_channel": {"type": "integer", "minimum": 0},
            "none_in_window": {"type": "integer", "minimum": 0},
            "control_denied": {"description": "Spec 057 §6.4: tool calls with no attributed effect that a deny (or hook blocked) gates (fact F5).", "type": "integer", "minimum": 0}
          }
        },
        "output_match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state"],
          "properties": {
            "state": {"enum": ["applied", "not_applicable"]},
            "reason": {"enum": ["privacy_policy", "not_exposed"]}
          },
          "if": {"properties": {"state": {"const": "not_applicable"}}},
          "then": {"required": ["reason"]},
          "else": {"not": {"required": ["reason"]}}
        },
        "unexplained_host_events": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "event_ids"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "event_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/hostEventId"}}
          }
        },
        "lineage_truncated": {"type": "integer", "minimum": 0},
        "startup_effects": {
          "description": "Spec 056 revision 11, rule S0: the effects the agent process ran before its first model call of the run (no reported parent, a lower sequence than every exchange of the run on its epoch, no unverified position below it). Present only when there is one; the first 64 in sequence order with the full count. Never attributed to a call, never counted in links, never listed in unattributed_effects and never a reason of the effects chain.",
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "effects"],
          "properties": {
            "count": {"type": "integer", "minimum": 1},
            "effects": {
              "type": "array",
              "minItems": 1,
              "maxItems": 64,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["attempt_uid", "event_id"],
                "properties": {"attempt_uid": {"$ref": "#/$defs/scopeId"}, "event_id": {"$ref": "#/$defs/scopeId"}}
              }
            }
          }
        },
        "sandbox_events_unlinked": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count"],
          "properties": {"count": {"type": "integer", "minimum": 0}}
        },
        "remote_sandbox_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "event_ids"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "event_ids": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/hostEventId"}}
          }
        }
      }
    }
  }
}
