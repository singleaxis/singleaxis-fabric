{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/contracts/capture/v1/capture-manifest-record-v1.schema.json",
  "title": "Fabric capture manifest record v1 (draft, spec 049 §2.8)",
  "description": "The fabric.capture_manifest span: the closed attribute set that carries one fabric.capture-manifest/v1 document (contracts/coverage/v1). Generated by scripts/contracts/validate_coverage_contracts.py from the coverage manifest schema and the telemetry-key registry (manifest_property); do not edit by hand. capture_points travel as '<id>@<version>:<kind>:<state>:<process_global 0/1>:<opt_in 0/1>:<reason or ->' strings and their field ids as '<id>=<field id>,...'; unsealed prior epochs as decimal strings. A manifest never carries fabric.wire.exchange_id, fabric.heartbeat.last_sequence or fabric.loss.reason, so it never occupies or explains a source position.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "attributes"
  ],
  "properties": {
    "schema_version": {
      "const": "fabric.capture-manifest-record/v1"
    },
    "name": {
      "const": "fabric.capture_manifest"
    },
    "attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fabric.capture.manifest_id",
        "fabric.event_id",
        "fabric.manifest.after_source_sequence",
        "fabric.manifest.capture_point_fields",
        "fabric.manifest.capture_points",
        "fabric.manifest.chunk_boundaries_retained",
        "fabric.manifest.clock.domain",
        "fabric.manifest.clock.uncertainty_ns",
        "fabric.manifest.content_capture",
        "fabric.manifest.coverage_profile",
        "fabric.manifest.emitted_at",
        "fabric.manifest.identity_mode",
        "fabric.manifest.inputs",
        "fabric.manifest.limits.max_body_bytes",
        "fabric.manifest.limits.max_inflight_bytes",
        "fabric.manifest.limits.max_retain_bytes",
        "fabric.manifest.limits.open_run_deadline_s",
        "fabric.manifest.limits.part_min_bytes",
        "fabric.manifest.limits.queue_max_items",
        "fabric.manifest.limits.records_max_object_bytes",
        "fabric.manifest.manifest_seq",
        "fabric.manifest.profile",
        "fabric.manifest.pseudonym_mode",
        "fabric.manifest.role_table_version",
        "fabric.manifest.runtime.name",
        "fabric.manifest.runtime.version",
        "fabric.manifest.sdk.language",
        "fabric.manifest.sequence_unit",
        "fabric.manifest.source_auth",
        "fabric.manifest.spool_encrypted",
        "fabric.manifest.uncaptured_classes",
        "fabric.manifest.unsealed_prior_epoch_count",
        "fabric.manifest.unsealed_prior_epochs",
        "fabric.schema_version",
        "fabric.sdk.version",
        "fabric.source.epoch",
        "fabric.source_id"
      ],
      "properties": {
        "fabric.capture.manifest_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "fabric.event_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "fabric.manifest.after_source_sequence": {
          "type": "integer",
          "minimum": -1
        },
        "fabric.manifest.capture_point_fields": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,63}=([XCSND][0-9]{2}(,[XCSND][0-9]{2}){0,255})?$"
          }
        },
        "fabric.manifest.capture_points": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.]{0,63}@[0-9A-Za-z.+-]{1,32}:(F|W|H|R|P|I|S):(active|installed_inactive|disabled|unsupported|failed):[01]:[01]:(not_instrumented|hook_disabled|not_configured|unsupported_api|unsupported_runtime|unsupported_version|parse_failed|body_cap|part_cap|inflight_budget|queue_full|shutdown|internal_error|span_dropped|store_failed|destination_rejected|transport_incomplete|stream_closed_early|privacy_policy|protection_failed|missing_capture_policy|missing_id_key|missing_spool_key|provider_redacted|provider_encrypted|provider_summarised|provider_not_returned|provider_held|caller_omitted|deferred_to_explicit|explicit_withheld|not_exposed|source_lost|segment_missing|segment_conflict|run_unterminated|post_terminal_activity|clock_uncertain|source_unauthenticated|unsealed_epoch|seal_mismatch|uninstrumented_client|sampling|retention_expired|deleted|-)$"
          }
        },
        "fabric.manifest.capture_policy.encrypted_store_required": {
          "type": "boolean"
        },
        "fabric.manifest.capture_policy.policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fabric.manifest.capture_policy.policy_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "fabric.manifest.capture_policy.policy_version": {
          "type": "integer",
          "minimum": 1
        },
        "fabric.manifest.chunk_boundaries_retained": {
          "type": "boolean"
        },
        "fabric.manifest.clock.domain": {
          "const": "wall_utc"
        },
        "fabric.manifest.clock.uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "fabric.manifest.content_capture": {
          "enum": [
            "enabled",
            "disabled",
            "metadata_only"
          ]
        },
        "fabric.manifest.content_capture_reason": {
          "enum": [
            "missing_capture_policy",
            "missing_id_key",
            "missing_spool_key",
            "not_configured",
            "hook_disabled"
          ]
        },
        "fabric.manifest.coverage_profile": {
          "type": "string",
          "pattern": "^fabric\\.profile\\.[a-z0-9-]+/v[0-9]+$"
        },
        "fabric.manifest.emitted_at": {
          "type": "string",
          "format": "date-time"
        },
        "fabric.manifest.endpoint_set_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fabric.manifest.explicit_wins": {
          "type": "boolean"
        },
        "fabric.manifest.identity_mode": {
          "enum": [
            "pseudonymous",
            "clear"
          ]
        },
        "fabric.manifest.inputs": {
          "type": "array",
          "uniqueItems": true,
          "minItems": 1,
          "items": {
            "enum": [
              "wire",
              "records"
            ]
          }
        },
        "fabric.manifest.key_id": {
          "type": "string",
          "pattern": "^kid-[0-9a-f]{8}$"
        },
        "fabric.manifest.limits.max_body_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "fabric.manifest.limits.max_inflight_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "fabric.manifest.limits.max_retain_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "fabric.manifest.limits.open_run_deadline_s": {
          "type": "integer",
          "minimum": 60,
          "maximum": 31536000
        },
        "fabric.manifest.limits.part_min_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "fabric.manifest.limits.queue_max_items": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        },
        "fabric.manifest.limits.records_max_object_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16777216
        },
        "fabric.manifest.manifest_seq": {
          "type": "integer",
          "minimum": 0
        },
        "fabric.manifest.max_clock_uncertainty_ns": {
          "type": "integer",
          "minimum": 0
        },
        "fabric.manifest.previous_manifest_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "fabric.manifest.profile": {
          "enum": [
            "local",
            "production"
          ]
        },
        "fabric.manifest.pseudonym_mode": {
          "enum": [
            "keyed",
            "unkeyed"
          ]
        },
        "fabric.manifest.role_table_version": {
          "type": "string",
          "pattern": "^fabric\\.content-role-table/v[0-9]+@[0-9]+$"
        },
        "fabric.manifest.runtime.name": {
          "enum": [
            "cpython",
            "pypy",
            "nodejs",
            "other"
          ]
        },
        "fabric.manifest.runtime.version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z.+-]{1,64}$"
        },
        "fabric.manifest.sdk.language": {
          "enum": [
            "python",
            "typescript"
          ]
        },
        "fabric.manifest.sequence_unit": {
          "enum": [
            "exchange",
            "record"
          ]
        },
        "fabric.manifest.source_auth": {
          "enum": [
            "bound",
            "unbound"
          ]
        },
        "fabric.manifest.spool_encrypted": {
          "type": "boolean"
        },
        "fabric.manifest.spool_key_id": {
          "type": "string",
          "pattern": "^kid-[0-9a-f]{8}$"
        },
        "fabric.manifest.uncaptured_classes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "requests",
              "urllib3",
              "boto3",
              "aiohttp",
              "grpc",
              "websocket",
              "webrtc",
              "node_http",
              "axios",
              "custom_fetch",
              "node_below_24",
              "stdio_mcp",
              "direct_pipe_reads",
              "provider_batch_files",
              "non_post_endpoints",
              "unmatched_endpoints",
              "other_runtime"
            ]
          }
        },
        "fabric.manifest.unsealed_prior_epoch_count": {
          "type": "integer",
          "minimum": 0
        },
        "fabric.manifest.unsealed_prior_epochs": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^(?P<epoch>0|[1-9][0-9]{0,18})$"
          }
        },
        "fabric.schema_version": {
          "const": "fabric.capture-manifest/v1"
        },
        "fabric.sdk.version": {
          "type": "string",
          "pattern": "^[0-9A-Za-z.+-]{1,64}$"
        },
        "fabric.source.epoch": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "fabric.source_id": {
          "type": "string",
          "maxLength": 160
        }
      },
      "dependentRequired": {
        "fabric.manifest.capture_policy.encrypted_store_required": [
          "fabric.manifest.capture_policy.policy_id",
          "fabric.manifest.capture_policy.policy_version",
          "fabric.manifest.capture_policy.policy_digest"
        ],
        "fabric.manifest.capture_policy.policy_digest": [
          "fabric.manifest.capture_policy.policy_id",
          "fabric.manifest.capture_policy.policy_version"
        ],
        "fabric.manifest.capture_policy.policy_id": [
          "fabric.manifest.capture_policy.policy_version",
          "fabric.manifest.capture_policy.policy_digest"
        ],
        "fabric.manifest.capture_policy.policy_version": [
          "fabric.manifest.capture_policy.policy_id",
          "fabric.manifest.capture_policy.policy_digest"
        ]
      },
      "if": {
        "properties": {
          "fabric.manifest.manifest_seq": {
            "minimum": 1
          }
        },
        "required": [
          "fabric.manifest.manifest_seq"
        ]
      },
      "then": {
        "required": [
          "fabric.manifest.previous_manifest_digest"
        ]
      }
    }
  }
}
