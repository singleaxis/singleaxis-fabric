{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://singleaxis.ai/contracts/capture/v1/loss-record-v1.schema.json",
  "title": "Fabric capture loss record / heartbeat v1 (draft, spec 042 rev 4)",
  "description": "JSON form of a fabric.capture_loss or fabric.capture_heartbeat span. A loss names a range of a source's exchange sequences that will never produce an exchange span; a heartbeat declares the last exchange sequence the source has allocated, which is how tail loss becomes detectable. Records do not consume sequences and carry no content. Loss records only explain gaps: a sequence that is neither an exchange nor inside a loss range is still a detected gap.",
  "type": "object",
  "required": ["schema_version", "kind", "source", "emitted_at"],
  "properties": {
    "schema_version": {"const": "fabric.loss-record/v1"},
    "kind": {"enum": ["loss", "heartbeat"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_epoch"],
      "properties": {
        "source_id": {"$ref": "#/$defs/opaqueId"},
        "source_epoch": {"type": "integer", "minimum": 0}
      }
    },
    "emitted_at": {"type": "string", "format": "date-time"}
  },
  "oneOf": [
    {
      "additionalProperties": false,
      "required": ["reason", "count", "first_sequence", "last_sequence"],
      "properties": {
        "schema_version": true,
        "kind": {"const": "loss"},
        "source": true,
        "emitted_at": true,
        "reason": {"enum": ["queue_full", "internal_error", "shutdown", "span_dropped"]},
        "count": {"type": "integer", "minimum": 1},
        "first_sequence": {"type": "integer", "minimum": 0},
        "last_sequence": {"type": "integer", "minimum": 0}
      }
    },
    {
      "additionalProperties": false,
      "required": ["last_sequence"],
      "properties": {
        "schema_version": true,
        "kind": {"const": "heartbeat"},
        "source": true,
        "emitted_at": true,
        "last_sequence": {"type": "integer", "minimum": -1},
        "run_id": {"$ref": "#/$defs/opaqueId"}
      }
    }
  ],
  "$defs": {
    "opaqueId": {
      "type": "string", "minLength": 1, "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    }
  }
}
