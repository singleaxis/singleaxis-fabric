{
  "schema_version": "fabric.release-policy/v1",
  "required_workflows": [
    "recorder-ci.yml",
    "recorder-security.yml",
    "codeql.yml",
    "recorder-license.yml",
    "e2e.yml",
    "e2e-production-profile.yml"
  ],
  "python_distribution": {
    "name": "singleaxis-fabric",
    "required_wheel_paths": [
      "fabric/__init__.py",
      "fabric/_content.py",
      "fabric/_content_sink.py",
      "fabric/_content_writer.py",
      "fabric/_version.py",
      "fabric/byte_evidence.py",
      "fabric/byte_resolver.py",
      "fabric/call_otlp.py",
      "fabric/call_recorder.py",
      "fabric/call_reconcile.py",
      "fabric/evidence_attestation.py",
      "fabric/independent_feed.py",
      "fabric/independent_store.py",
      "fabric/receipt_sets.py",
      "fabric/qualified_run.py",
      "fabric/content_store/__init__.py",
      "fabric/content_store/base.py",
      "fabric/content_store/local.py",
      "fabric/content_store/s3.py",
      "fabric/py.typed",
      "fabric/resolver.py",
      "fabric/adapters/byte_boundary.py",
      "fabric/byte_spool.py",
      "fabric/client.py",
      "fabric/content_join.py",
      "fabric/decision.py",
      "fabric/deployment_policy.py",
      "fabric/governed_reconstruction.py",
      "fabric/governed_store.py",
      "fabric/metadata_delivery.py",
      "fabric/source_spool.py"
    ],
    "allowed_wheel_package_roots": [
      "fabric"
    ],
    "forbidden_wheel_paths": [
      "fabric/_chain.py",
      "fabric/_uds.py",
      "fabric/adapters/agent_framework.py",
      "fabric/adapters/langgraph.py",
      "fabric/cli.py",
      "fabric/deployment.py",
      "fabric/escalation.py",
      "fabric/eval.py",
      "fabric/guardrails.py",
      "fabric/judge.py",
      "fabric/judge_runner.py",
      "fabric/nemo.py",
      "fabric/policy.py",
      "fabric/presidio.py",
      "fabric/stream.py",
      "fabric/tool_auth.py"
    ],
    "forbidden_wheel_prefixes": [
      "fabric/guardrail_adapters/",
      "fabric/judge_adapters/",
      "fabric/policy_adapters/",
      "fabric/queue_transports/"
    ],
    "required_console_scripts": {},
    "required_sdist_paths": [
      "pyproject.toml",
      "README.md",
      "LICENSE",
      "src/fabric/__init__.py",
      "src/fabric/_content.py",
      "src/fabric/_content_sink.py",
      "src/fabric/_content_writer.py",
      "src/fabric/_version.py",
      "src/fabric/byte_evidence.py",
      "src/fabric/byte_resolver.py",
      "src/fabric/call_otlp.py",
      "src/fabric/call_recorder.py",
      "src/fabric/call_reconcile.py",
      "src/fabric/evidence_attestation.py",
      "src/fabric/independent_feed.py",
      "src/fabric/independent_store.py",
      "src/fabric/receipt_sets.py",
      "src/fabric/qualified_run.py",
      "src/fabric/content_store/__init__.py",
      "src/fabric/content_store/base.py",
      "src/fabric/content_store/local.py",
      "src/fabric/content_store/s3.py",
      "src/fabric/py.typed",
      "src/fabric/resolver.py",
      "src/fabric/adapters/byte_boundary.py",
      "src/fabric/byte_spool.py",
      "src/fabric/client.py",
      "src/fabric/content_join.py",
      "src/fabric/decision.py",
      "src/fabric/deployment_policy.py",
      "src/fabric/governed_reconstruction.py",
      "src/fabric/governed_store.py",
      "src/fabric/metadata_delivery.py",
      "src/fabric/source_spool.py"
    ],
    "allowed_sdist_top_level": [
      "src",
      "pyproject.toml",
      "README.md",
      "LICENSE",
      ".gitignore",
      "PKG-INFO"
    ],
    "forbidden_sdist_paths": [
      "src/fabric/_chain.py",
      "src/fabric/_uds.py",
      "src/fabric/adapters/agent_framework.py",
      "src/fabric/adapters/langgraph.py",
      "src/fabric/cli.py",
      "src/fabric/deployment.py",
      "src/fabric/escalation.py",
      "src/fabric/eval.py",
      "src/fabric/guardrails.py",
      "src/fabric/judge.py",
      "src/fabric/judge_runner.py",
      "src/fabric/nemo.py",
      "src/fabric/policy.py",
      "src/fabric/presidio.py",
      "src/fabric/stream.py",
      "src/fabric/tool_auth.py"
    ],
    "forbidden_sdist_prefixes": [
      "src/fabric/guardrail_adapters/",
      "src/fabric/judge_adapters/",
      "src/fabric/policy_adapters/",
      "src/fabric/queue_transports/"
    ]
  },
  "contracts": {
    "archive_prefix": "singleaxis-fabric-contracts",
    "manifest_name": "manifest.json",
    "require_sha256_for_json": true,
    "public_families": [
      "activity",
      "connect",
      "content",
      "delivery",
      "privacy",
      "recorder"
    ],
    "public_versions": {
      "activity": [
        "v2"
      ],
      "connect": [
        "v1"
      ],
      "content": [
        "v1"
      ],
      "delivery": [
        "v1"
      ],
      "privacy": [
        "v1"
      ],
      "recorder": [
        "v1"
      ]
    }
  },
  "helm": {
    "first_party_app_charts": [
      "otel-collector"
    ],
    "third_party_app_charts": []
  },
  "images": [
    "fabric-otelcol",
    "fabric-host-emitter"
  ]
}
