  "contracts": {
    "archive_prefix": "singleaxis-fabric-contracts",
    "manifest_name": "manifest.json",
    "require_sha256_for_json": true,
    "public_families": [
      "activity",
      "connect",
      "content",
      "delivery",
      "privacy",
      "recorder"
    ],
    "public_versions": {
      "activity": [
        "v2"
      ],
      "connect": [
        "v1"
      ],
      "content": [
        "v1"
      ],
      "delivery": [
        "v1"
      ],
      "privacy": [
        "v1"
      ],
      "recorder": [
        "v1"
      ]
    }
  },
  "helm": {
    "first_party_app_charts": [
      "otel-collector"
    ],
    "third_party_app_charts": []
  },
  "images": [
    "fabric-otelcol",
    "fabric-host-emitter",
    "fabric-cli"
  ],
  "ghcr_packages": [
    "fabric-otelcol",
    "fabric-host-emitter",
    "fabric-cli",
    "charts/fabric"
  ],
  "image_metadata": {
    "fabric-otelcol": {
      "title": "SingleAxis Fabric Node",
      "description": "SingleAxis Fabric OTel Collector recorder distribution (capture, protect, deliver)"
    },
    "fabric-host-emitter": {
      "title": "SingleAxis Fabric host emitter",
      "description": "SingleAxis Fabric eBPF host sensor: records process starts and connections for the recorder (capture, protect, deliver)"
    },
    "fabric-cli": {
      "title": "SingleAxis Fabric CLI",
      "description": "SingleAxis Fabric operator CLI: sets up, starts, launches capture for and checks the recorder on your own infrastructure (capture, protect, deliver)"
    }
  },
  "cli_image": {
    "comment": "Spec 058 sections 4.1 (I1) and 11.1: what the fabric-cli image must hold (scripts/release/check_cli_image.py). Its CLI ships exactly the I1 commands; the installed singleaxis-fabric files obey python_distribution's forbidden paths; the clients it carries are Docker with the Compose plugin and Helm; it runs as a non-root user.",
    "image": "fabric-cli",
    "commands": [
      "plan",
      "init",
      "up",
      "down",
      "run",
      "verify",
      "doctor",
      "show",
      "version",
      "help"
    ],
    "clients": {
      "docker": [
        "docker",
        "--version"
      ],
      "docker compose": [
        "docker",
        "compose",
        "version"
      ],
      "helm": [
        "helm",
        "version",
        "--short"
      ]
    },
    "distribution": "singleaxis-fabric",
    "extras": [
      "cli",
      "otlp"
    ],
    "services_comment": "Spec 058 section 10.4: the chart runs the opt-in pod injector from this image as a Python module, not a fabric command (the I1 command list is unchanged). check_cli_image.py runs each probe and requires its marker in the answer.",
    "services": {
      "injector": {
        "probe": [
          "/opt/fabric/bin/python",
          "-m",
          "fabric.cli._injector",
          "--help"
        ],
        "marker": "--tls-dir"
      }
    }
  },
  "forbidden_capability_terms": {
    "comment": "AGENTS.md: no release artifact advertises capabilities outside Capture -> Protect -> Deliver. Case-insensitive regular expressions matched against image labels and annotations and packaged metadata fields (descriptions, titles, keywords, summaries).",
    "patterns": [
      "evaluat",
      "judge",
      "enforc",
      "red[-_ ]?team",
      "verdict_engine",
      "guardrail",
      "escalat"
    ]
  }
}
