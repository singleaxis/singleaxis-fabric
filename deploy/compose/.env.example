# Copy to .env (`cp .env.example .env`) and chmod 0600 -- this file carries
# secrets for the production profile. .env is gitignored; .env.example is not.

# ── Port bindings (evaluation + production) ──────────────────────────────
# VM-overlay OTLP bind address only. All evaluation ports and the overlay's
# health/metrics ports are always loopback-only. Before binding VM OTLP to a
# LAN address, enable receiver TLS and review the firewall/trust boundary.
# FABRIC_BIND_ADDR=127.0.0.1
# FABRIC_OTLP_GRPC_PORT=4317
# FABRIC_OTLP_HTTP_PORT=4318
# Content ingress (spec 048): agents in node mode POST stored bodies here.
# Evaluation publishes it on loopback; production only with the opt-in content
# path below, on FABRIC_BIND_ADDR like 4317/4318 and held to the same TLS rule.
# FABRIC_OTLP_CONTENT_PORT=4319
# FABRIC_HEALTH_PORT=13133

# Evaluation harness only: host port for the controlled test sink.
# FABRIC_SINK_PORT=8080

# ── Production overlay (required; deployment fails closed without them) ──
# Customer-selected OTLP/HTTP destination. Use an https:// endpoint --
# certificate verification is enabled and plaintext egress is unsupported.
# FABRIC_EXPORT_ENDPOINT=https://otlp.example.internal:4318
# Full Authorization header value sent on egress, e.g. "Bearer <token>".
# FABRIC_EXPORT_AUTH_HEADER=Bearer replace-me
# Host path to the file containing the bearer token OTLP senders must
# present. Mounted into the collector as a Compose secret (never an env var)
# with its host owner and mode; the container runs as uid/gid 65532, so make
# it operator-owned, group 65532, mode 0440 (preflight reads it as you, the
# container reads it through the group, nobody else can):
#   sudo chown "$(id -u)":65532 secrets/ingress.token && chmod 0440 secrets/ingress.token
# FABRIC_INGRESS_TOKEN_FILE=./secrets/ingress.token
# Tenant id the content exporter accepts; agents send the same value as
# FABRIC_TENANT_ID. Evaluation defaults to "evaluation"; the production
# content path (below) requires it.
# FABRIC_TENANT_ID=replace-with-opaque-tenant-id

# ── Content path (production, spec 048, opt-in) ──────────────────────────
# Unset (default): the production Node is telemetry only, unchanged.
# The Fabric Node is the only content writer; agents hold no store
# credentials. "s3" adds docker-compose.content.yml and
# docker-compose.content-s3.yml: the Node writes with its own identity (EC2
# instance role via IMDSv2 with hop limit 2, or a credentials-file secret for
# an S3-compatible store), always with server-side encryption. "file" keeps
# content on the fabric-content volume, which has no server-side encryption:
# preflight refuses it unless FABRIC_CONTENT_REQUIRE_SSE=false records that
# the host disk's encryption is accepted instead (as the Helm chart's
# content.requireServerSideEncryption=false).
# FABRIC_CONTENT_BACKEND=s3
# FABRIC_CONTENT_REQUIRE_SSE=true
# FABRIC_CONTENT_S3_BUCKET=customer-evidence
# FABRIC_CONTENT_S3_PREFIX=fabric/content/
# FABRIC_CONTENT_S3_REGION=eu-west-1
# Only for S3-compatible stores; https required by preflight. No credentials
# in the URL.
# FABRIC_CONTENT_S3_ENDPOINT=https://s3.internal.example:9000
# FABRIC_CONTENT_S3_PATH_STYLE=false
# aws:kms (default; optional key id) or AES256. Production never stores
# content unencrypted.
# FABRIC_CONTENT_S3_SSE=aws:kms
# FABRIC_CONTENT_S3_KMS_KEY_ID=arn:aws:kms:eu-west-1:111122223333:key/<id>

# ── S3 evaluation store overlay (docker-compose.s3-eval.yml, make up-s3-eval) ──
# Evaluation-only defaults exist for every value; override to test your own.
# Secrets must not contain double quotes or backslashes.
# FABRIC_S3_EVAL_PORT=9000
# FABRIC_S3_EVAL_BUCKET=fabric-content
# FABRIC_S3_EVAL_ROOT_ACCESS_KEY=fabric-eval-root
# FABRIC_S3_EVAL_ROOT_SECRET_KEY=...
# FABRIC_S3_EVAL_SSE_KEK=<hex of 32 random bytes: openssl rand -hex 32>
# FABRIC_S3_EVAL_NODE_ACCESS_KEY=fabric-node-writer
# FABRIC_S3_EVAL_NODE_SECRET_KEY=...
# FABRIC_S3_EVAL_READER_ACCESS_KEY=fabric-reader
# FABRIC_S3_EVAL_READER_SECRET_KEY=...

# ── Production overlay (optional) ────────────────────────────────────────
# Run a signed release image instead of building locally (verify the cosign
# signature per docs/verify-release.md first). Pull policy must switch from
# the local-build default so Compose pulls rather than tags a local build.
# FABRIC_NODE_IMAGE=ghcr.io/singleaxis/fabric-otelcol@sha256:<approved-64-hex>
# FABRIC_NODE_PULL_POLICY=always
# Host port for the collector's Prometheus metrics endpoint (loopback-only).
# FABRIC_METRICS_PORT=8888
# Directory mounted read-only at /run/fabric-node/tls for receiver TLS
# material (and an egress private-CA bundle). Ignored while the tls: stanzas
# stay commented.
# FABRIC_INGRESS_TLS_DIR=./tls
# FABRIC_INGRESS_TLS_CERT_FILE=/run/fabric-node/tls/server.crt
# FABRIC_INGRESS_TLS_KEY_FILE=/run/fabric-node/tls/server.key
# Private-CA bundle for egress TLS when the destination uses a non-public
# certificate (uncomment the ca_file line in collector-production.yaml too).
# A container path under /run/fabric-node/tls, i.e. a file in
# FABRIC_INGRESS_TLS_DIR; preflight checks that it exists and is readable.
# FABRIC_EXPORT_CA_FILE=/run/fabric-node/tls/ca.crt
# Container user the preflight checks file access for. Change only when
# running an image built with a different nonroot uid/gid.
# FABRIC_NODE_UID=65532
# FABRIC_NODE_GID=65532
# Compose command override when `docker compose` is not on PATH.
# COMPOSE="docker compose"
