 	// Filename points to a file that contains the bearer token(s) to use for every RPC.
 	Filename string `mapstructure:"filename,omitempty"`
 
+	// RequireSingleToken enables strict dedicated-source file authentication.
+	RequireSingleToken bool `mapstructure:"require_single_token,omitempty"`
+
 	// prevent unkeyed literal initialization
 	_ struct{}
@@ -41,9 +45,12 @@ func (cfg *Config) Validate() error {
 func (cfg *Config) Validate() error {
 	if cfg.BearerToken == "" && len(cfg.Tokens) == 0 && cfg.Filename == "" {
 		return errNoTokenProvided
 	}
 	if cfg.BearerToken != "" && len(cfg.Tokens) > 0 {
 		return errTokensAndTokenProvided
 	}
+	if cfg.RequireSingleToken && (cfg.Filename == "" || cfg.BearerToken != "" || len(cfg.Tokens) > 0) {
+		return errors.New("require_single_token requires a filename without inline tokens")
+	}
 	return nil
 }

