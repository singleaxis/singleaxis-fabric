+// Copyright The OpenTelemetry Authors
+// SPDX-License-Identifier: Apache-2.0
+
+package bearertokenauthextension // import "github.com/open-telemetry/opentelemetry-collector-contrib/extension/bearertokenauthextension"
+
+import (
+	"errors"
+	"os"
+	"path/filepath"
+	"time"
+
+	"github.com/fsnotify/fsnotify"
+	"go.uber.org/zap"
+)
+
+const (
+	strictMinTokenBytes = 32
+	strictMaxTokenBytes = 4096
+	strictPollInterval  = time.Second
+)
+
+// strictTokenFile is the require_single_token reader. Unlike the shared
+// credentials-file resolver, which trims the file and keeps the last value
+// when a reload fails, it reads the raw bytes and installs zero accepted
+// tokens whenever the file is missing, unreadable or not exactly one valid
+// token. It reloads on any change in the file's parent directory (atomic
+// renames and projected Secret ..data swaps) and on a fixed poll, so an
+// unsafe rotation never leaves a stale credential accepted.
+type strictTokenFile struct {
+	filename string
+	logger   *zap.Logger
+	install  func([]string)
+
+	stop chan struct{}
+	done chan struct{}
+}
+
+func (s *strictTokenFile) refresh() {
+	data, err := os.ReadFile(s.filename)
+	if err != nil {
+		s.install(nil)
+		s.logger.Warn("unreadable singleton bearer token file", zap.String("filename", s.filename), zap.Error(err))
+		return
+	}
+	if len(data) < strictMinTokenBytes || len(data) > strictMaxTokenBytes {
+		s.install(nil)
+		s.logger.Warn("invalid singleton bearer token file length", zap.String("filename", s.filename))
+		return
+	}
+	for _, ch := range data {
+		if ch <= 0x20 || ch >= 0x7f {
+			s.install(nil)
+			s.logger.Warn("invalid singleton bearer token file format", zap.String("filename", s.filename))
+			return
+		}
+	}
+	s.install([]string{string(data)})
+}
+
+// start watches the parent directory and polls until shutdown. It is not
+// tied to the Start context: the watch must outlive Start.
+func (s *strictTokenFile) start() error {
+	if s.stop != nil {
+		return errors.New("singleton bearer token watcher already started")
+	}
+	watcher, err := fsnotify.NewWatcher()
+	if err != nil {
+		return err
+	}
+	dir := filepath.Dir(s.filename)
+	if err := watcher.Add(dir); err != nil {
+		_ = watcher.Close()
+		return err
+	}
+	s.stop = make(chan struct{})
+	s.done = make(chan struct{})
+	s.refresh()
+	go s.watch(watcher, dir)
+	return nil
+}
+
+func (s *strictTokenFile) watch(watcher *fsnotify.Watcher, dir string) {
+	defer close(s.done)
+	defer watcher.Close()
+	ticker := time.NewTicker(strictPollInterval)
+	defer ticker.Stop()
+	events, errs := watcher.Events, watcher.Errors
+	for {
+		select {
+		case <-s.stop:
+			return
+		case <-ticker.C:
+			s.refresh()
+		case event, ok := <-events:
+			if !ok {
+				// The poll keeps reloading without the watch.
+				events = nil
+				continue
+			}
+			if event.Name == s.filename || event.Name == dir || filepath.Dir(event.Name) == dir {
+				s.refresh()
+			}
+		case err, ok := <-errs:
+			if !ok {
+				errs = nil
+				continue
+			}
+			s.logger.Warn("singleton bearer token watch error", zap.String("filename", s.filename), zap.Error(err))
+		}
+	}
+}
+
+func (s *strictTokenFile) shutdown() {
+	if s.stop != nil {
+		close(s.stop)
+		<-s.done
+		s.stop = nil
+	}
+}
